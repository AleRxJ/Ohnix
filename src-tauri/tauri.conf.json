{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ohnix",
  "version": "0.1.0",
  "identifier": "co.ohnix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ./Frontend -- --port 3000 --strictPort",
    "beforeBuildCommand": "npm run build --prefix ./Frontend",
    "devUrl": "http://localhost:3000/app.html",
    "frontendDist": "../Frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ohnix",
        "url": "https://ohnix.co/login",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://ohnix.onrender.com wss://ohnix.onrender.com http://localhost:3001 ws://localhost:3001 http://localhost:3000 ws://localhost:3000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NUNBRDY4Q0I5MzJGMzkKUldRNUw1UExhSzFjWmxuNkgrLzZmVWNCQldiQUc4elAzWjU1SGJ4NEdlRW0vZlRXbklTNHd4UEQK",
      "endpoints": [
        "https://github.com/AleRxJ/Ohnix/releases/latest/download/latest.json"
      ]
    }
  }
}
