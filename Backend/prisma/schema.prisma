generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum PlanType {
  starter
  growth
  scale
  enterprise
}

enum SubscriptionStatus {
  active
  paused
  canceled
}

enum UpgradeRequestStatus {
  open
  reviewing
  approved
  rejected
  closed
}

// MONTHLY is the only cycle that has ever existed - every row predating this
// enum defaults here on migration, which is also literally what those rows
// mean (every historical checkout was a 30-day cycle, see
// closeApprovedRequestAndActivatePlan). ANNUAL means "paga 10 meses, lleva
// 12" - the charged amount is 10x the monthly price (computed in
// payment.service.js/epayco.service.js, never stored as a separate price),
// and the period it grants is 365 days instead of 30.
enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum ProductStatus {
  draft
  active
  archived
}

enum IntegrationProvider {
  shopify
  woocommerce
  custom_api
}

enum IntegrationStatus {
  connected
  error
  disconnected
}

enum ExternalEntityType {
  product
  variant
  order
  customer
}

enum SyncLogDirection {
  inbound
  outbound
}

enum SyncLogStatus {
  success
  error
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum OrderStatus {
  pending
  processing
  completed
  cancelled
  // Reached only as a side effect of order.service.js#processReturn once
  // every OrderDetail line on the order has nothing left pending - never a
  // client-settable transition target. Distinct from "cancelled": a
  // cancelled order was voided outright, a returned order was a real
  // completed sale the customer later brought some or all of back.
  returned
}

enum PurchaseStatus {
  pending
  completed
  returned
}

enum ElectronicInvoiceStatus {
  draft
  issuing
  submitted
  accepted
  rejected
  error
  cancelled
  // Reached only via the itcycle-api-dian provider: the document was built,
  // signed, and delivered to the customer, but DIAN itself was unreachable
  // when it was sent - see electronicInvoicing.service.js#mapItcycleResponse
  // and itcycle-api-dian's own docs/dian/sandbox-tests.md#contingencia. Not
  // reachable via Factus/Alanube, which don't distinguish this case.
  contingency
}

enum TeamMemberStatus {
  active
  removed
}

enum TeamInvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum PermissionLevel {
  none
  view
  edit
  admin
}

enum StockMovementSourceType {
  purchase
  purchase_return
  order
  order_cancellation
  order_return
  // A connector (Shopify, a custom-API caller, etc.) pushing a stock
  // correction into Ohnix from the external channel's own count - see
  // connectors/base.connector.js. Distinct from "adjustment" so the ledger
  // shows whether a human or an external system made the change.
  channel_sync
  // Automatic restock triggered by issuing an electronic-invoice credit note
  // with a conceptCode that represents goods actually coming back
  // ("partial_return"/"cancellation" - see
  // electronicInvoicing.service.js#issueCreditNoteForInvoice). sourceId is
  // the ElectronicCreditNote's id, not the order's, so a movement traces
  // back to the specific fiscal document that caused it.
  credit_note_restock
  adjustment
  // Paired rows for a transfer between two Points of Sale of the same
  // account - always written together in one transaction (see
  // productLocationStock.service.js#transferStock), sharing one sourceId
  // (a synthetic transfer id) so the two sides of the same move are
  // traceable to each other in the ledger.
  transfer_out
  transfer_in
  // A zero-delta audit entry - the transfer_out/transfer_in pair above
  // already fully accounts for the real balance change (source lost
  // quantitySent, destination gained quantityReceived); this doesn't
  // change either location's stock, it just makes the shortfall itself
  // show up in the product's movement history instead of being visible
  // only on the StockTransfer record's own discrepancy field. See
  // stockTransfer.service.js#receiveTransfer.
  transfer_discrepancy
  // A completed ProductionOrder - production_consumption for each raw
  // material line leaving stock, production_output for the finished
  // product arriving, both sharing the order's id as sourceId so the two
  // sides of the same run are traceable to each other, same pairing idiom
  // as transfer_out/transfer_in. production_reversal covers every
  // movement (finished good OUT, every material back IN) when a completed
  // order gets cancelled - one type for the whole reversal event, same
  // "cancellation gets its own single value" idiom as order_cancellation.
  production_consumption
  production_output
  production_reversal
}

// Whether a company is a "responsable" or "no responsable" of VAT under
// Estatuto Tributario art. 437 - a fact about the company, entirely
// independent of what any individual product is taxed at. Starts at `unset`
// (never `responsible`) so nothing charges VAT on a company's behalf before
// an admin has actually confirmed its status - see electronicInvoicing.
// service.js, which refuses to submit a DIAN document while this is `unset`.
enum VatResponsibility {
  unset
  responsible
  not_responsible
}

// Which income-tax regime a company files under (ET Libro I for Régimen
// Ordinario, art. 903-916 ET for Régimen Simple de Tributación/RST) - drives
// which calculation rentaDeclaration.service.js applies. Null until the
// company (ideally with their accountant) confirms it - same "unset until
// confirmed" convention as vatResponsible above, and for the same reason:
// nothing should compute an estimated tax liability before this is known.
enum TaxRegime {
  ordinario
  simple
}

// The 4 activity groups Art. 908 ET splits RST's tariff table into - each
// has its own set of income brackets/rates in SimpleRegimeBracket. Only
// meaningful when Company.taxRegime is `simple`.
enum SimpleRegimeGroup {
  group1 // Tiendas, mini/micro-mercados, peluquerías
  group2 // Comercio al por mayor y al por detal; servicios técnicos y mecánicos
  group3 // Servicios profesionales, de consultoría y científicos
  group4 // Actividades industriales, incluidas agroindustriales
}

// Colombia's ET distinguishes "excluido" (art. 424/476 - the sale never
// causes VAT, and the seller gets no input-VAT credit) from "exento" (art.
// 477/478/481 - VAT applies at a 0% rate, and the seller DOES get an input
// credit). Collapsing these into one boolean (the old isTaxExcluded) silently
// misrepresented that distinction for every "exento" product ever entered.
enum ProductTaxTreatment {
  taxed
  excluded
  exempt
}

// Physical characteristics feed shipping/logistics quoting (carrier
// integrations aren't wired up yet, but every product already carries what
// a quote needs). WeightUnit/DimensionUnit are display preferences only -
// Product.weightValue/heightValue/widthValue/lengthValue are always
// persisted in grams/cm regardless of which unit the seller typed the
// number in, so nothing downstream (volumetric weight, order snapshots, a
// future carrier adapter) ever has to convert units back and forth.
enum WeightUnit {
  g
  kg
}

enum DimensionUnit {
  cm
  m
}

enum PackagingType {
  box
  envelope
  bag
  tube
  pallet
}

model User {
  id                String        @id @default(cuid())
  legacyMongoId     String?       @unique @map("legacy_mongo_id")
  username          String        @unique
  email             String        @unique
  password          String
  role              UserRole      @default(user)
  preferredLanguage String        @default("es") @map("preferred_language")
  theme             String        @default("dark") @map("theme")
  companyId         String?       @map("company_id")
  verifyOtp         String        @default("") @map("verify_otp")
  verifyOtpExpiry   BigInt        @default(0) @map("verify_otp_expiry")
  isVerified        Boolean       @default(false) @map("is_verified")
  resetOtp          String        @default("") @map("reset_otp")
  resetOtpExpiry    BigInt        @default(0) @map("reset_otp_expiry")
  avatar            String
  // Bumped on password change/reset to invalidate every access token issued
  // before that point (embedded in the JWT payload, compared in verifyJWT).
  tokenVersion      Int           @default(0) @map("token_version")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  subscription      Subscription?
  company           Company?      @relation(fields: [companyId], references: [id])

  categoriesCreated                    Category[]                     @relation("CategoryCreatedBy")
  categoriesUpdated                    Category[]                     @relation("CategoryUpdatedBy")
  unitsCreated                         Unit[]                         @relation("UnitCreatedBy")
  unitsUpdated                         Unit[]                         @relation("UnitUpdatedBy")
  productsCreated                      Product[]                      @relation("ProductCreatedBy")
  productsUpdated                      Product[]                      @relation("ProductUpdatedBy")
  customers                            Customer[]
  suppliers                            Supplier[]
  purchasesCreated                     Purchase[]                     @relation("PurchaseCreatedBy")
  purchasesUpdated                     Purchase[]                     @relation("PurchaseUpdatedBy")
  quotationsCreated                    PurchaseQuotation[]            @relation("QuotationCreatedBy")
  quotationsUpdated                    PurchaseQuotation[]            @relation("QuotationUpdatedBy")
  salesQuotationsCreated               SalesQuotation[]               @relation("SalesQuotationCreatedBy")
  salesQuotationsUpdated               SalesQuotation[]               @relation("SalesQuotationUpdatedBy")
  ordersCreated                        Order[]                        @relation("OrderCreatedBy")
  ordersUpdated                        Order[]                        @relation("OrderUpdatedBy")
  planUpgradeRequests                  PlanUpgradeRequest[]
  apiKeys                              ApiKey[]
  integrationConnections               IntegrationConnection[]
  webhookEndpoints                     WebhookEndpoint[]
  stockMovementsCreated                StockMovement[]                @relation("StockMovementCreatedBy")
  cashAccountsCreated                  CashAccount[]
  cashMovementsCreated                 CashMovement[]
  orderPaymentsRecorded                OrderPayment[]
  paymentCreditsCreated                PaymentCreditBalance[]         @relation("PaymentCreditCreatedBy")
  paymentCreditAccounts                PaymentCreditBalance[]         @relation("PaymentCreditAccount")
  orderPaymentAllocationsCreated       OrderPaymentAllocation[]       @relation("OrderPaymentAllocationCreatedBy")
  purchasePaymentsRecorded             PurchasePayment[]
  purchasePaymentAllocationsCreated    PurchasePaymentAllocation[]    @relation("PurchasePaymentAllocationCreatedBy")
  bankStatementEntriesAdded            BankStatementEntry[]
  chartAccountsCreated                 ChartAccount[]
  accountingPeriodsCreated             AccountingPeriod[]             @relation("AccountingPeriodCreatedBy")
  accountingPeriodsClosed              AccountingPeriod[]             @relation("AccountingPeriodClosedBy")
  fiscalYearClosuresOwned              FiscalYearClosure[]            @relation("FiscalYearClosureCreatedBy")
  fiscalYearClosuresClosed             FiscalYearClosure[]            @relation("FiscalYearClosureClosedBy")
  journalEntriesCreated                JournalEntry[]
  accountingConfigAuditsOwned          AccountingConfigAudit[]        @relation("AccountingConfigAuditAccount")
  costCentersOwned                     CostCenter[]                   @relation("CostCenterAccount")
  recurringExpenseTemplatesOwned       RecurringExpenseTemplate[]     @relation("RecurringExpenseTemplateAccount")
  accountingBudgetsOwned               AccountingBudget[]             @relation("AccountingBudgetAccount")
  accountingBudgetsCreated             AccountingBudget[]             @relation("AccountingBudgetCreatedBy")
  accountingBudgetsUpdated             AccountingBudget[]             @relation("AccountingBudgetUpdatedBy")
  financialStatementNotesOwned         FinancialStatementNote[]       @relation("FinancialStatementNoteAccount")
  financialStatementNotesCreated       FinancialStatementNote[]       @relation("FinancialStatementNoteCreatedBy")
  financialStatementNotesUpdated       FinancialStatementNote[]       @relation("FinancialStatementNoteUpdatedBy")
  fixedAssetsOwned                     FixedAsset[]                   @relation("FixedAssetCreatedBy")
  recurringJournalTemplatesOwned       RecurringJournalTemplate[]     @relation("RecurringJournalTemplateCreatedBy")
  productBatchesCreated                ProductBatch[]
  productionOrdersCreated              ProductionOrder[]              @relation("ProductionOrderCreatedBy")
  productionOrdersUpdated              ProductionOrder[]              @relation("ProductionOrderUpdatedBy")
  employeesCreated                     Employee[]                     @relation("EmployeeCreatedBy")
  employeesUpdated                     Employee[]                     @relation("EmployeeUpdatedBy")
  payrollPeriodsCreated                PayrollPeriod[]                @relation("PayrollPeriodCreatedBy")
  payrollPeriodsUpdated                PayrollPeriod[]                @relation("PayrollPeriodUpdatedBy")
  payrollBenefitSettlementsCreated     PayrollBenefitSettlement[]
  payrollTerminationSettlementsCreated PayrollTerminationSettlement[]
  accountingConfigAuditsPerformed      AccountingConfigAudit[]        @relation("AccountingConfigAuditActor")
  // Points of Sale belong to the account (same accountId every other model
  // scopes by - see teamContext.js), never to a Team, since most accounts
  // (starter/growth without a Team row) still need exactly one default
  // location - see PointOfSale below.
  pointsOfSaleOwned                    PointOfSale[]                  @relation("PointOfSaleAccount")
  stockTransfersRequested              StockTransfer[]                @relation("StockTransferRequestedBy")

  // Teams: a user is either a team owner (ownedTeam), a member of exactly one
  // active team at a time (via TeamMember, enforced in team.service.js - not
  // a DB constraint since removed rows must stay for history/rejoin), or
  // neither (a solo/independent account). See team.service.js for the
  // "who can create resources under whose account" resolution.
  ownedTeam       Team?            @relation("TeamOwner")
  teamMemberships TeamMember[]
  invitationsSent TeamInvitation[] @relation("InvitationsSent")

  adminAuditLogsPerformed AdminAuditLog[] @relation("AdminAuditLogAdmin")
  adminAuditLogsReceived  AdminAuditLog[] @relation("AdminAuditLogTarget")

  dianTestMatrixRunsRequested DianTestMatrixRun[]

  chatConversations ChatConversation[]

  certificateOrdersRequested CertificateOrder[]

  externalApiClientsCreated ExternalApiClient[]
  externalApiKeyIssuances   ExternalApiClientKeyIssuance[]

  receivedInvoiceReceiptsCreated ReceivedInvoiceReceipt[]

  sessions UserSession[]

  discoveriesOwned     Discovery[]
  metricSnapshotsOwned MetricSnapshot[]

  @@map("users")
}

// One row per device the user has an active login on (Web/Desktop/Mobile
// simultaneously, e.g. a shop owner's Desktop at the counter and phone in
// their pocket) - replaces the old single-sid-per-user model, which forced
// any second login to kick the first one off. deviceId is generated once by
// the client and persisted locally (localStorage - shared unchanged across
// Web/Desktop/Mobile since Desktop/Mobile are WebViews of the same app), so
// logging in again from the same browser/app updates this same row instead
// of creating a new "device" every time. sid is what the JWT actually
// carries and what isSessionValid checks per-request - see
// utils/sessionStore.js.
model UserSession {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  deviceId     String   @map("device_id")
  sid          String   @unique
  // "web" | "desktop" | "mobile" - derived from a custom User-Agent suffix
  // Desktop/Mobile's native shell sets (see sessionStore.js); defaults to
  // "web" when absent. Display-only plus lets the sessions list show an
  // icon per platform - never a security boundary (spoofing it only affects
  // your own account's device list, not access).
  deviceClass  String   @map("device_class")
  // Raw User-Agent at last login, shown in the sessions UI so a user can
  // tell "Chrome on Windows" apart from "Safari on iPhone" without any
  // separate device-naming feature.
  deviceLabel  String?  @map("device_label")
  // Replaces the old single global User.refreshToken column - one refresh
  // token per device instead of one for the whole account, which is what
  // actually lets two devices both stay logged in through their normal
  // token-refresh cycles instead of the second login silently invalidating
  // the first device's refresh token. Compared by exact value on rotation,
  // same as the old column was (see refreshAccessToken in
  // user.controller.js).
  refreshToken String?  @map("refresh_token")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_sessions")
}

model Company {
  id                               String             @id @default(cuid())
  name                             String             @unique
  legalName                        String?            @map("legal_name")
  countryCode                      String?            @map("country_code")
  contactEmail                     String?            @map("contact_email")
  phone                            String?
  electronicInvoicingEnabled       Boolean            @default(false) @map("electronic_invoicing_enabled")
  // Which provider issues this company's electronic invoices. Factus stays
  // fully wired (see factus.service.js) even though Alanube is the default
  // for new companies - kept dormant per-company rather than removed so it
  // can be switched back without re-integrating from scratch.
  electronicInvoicingProvider      String             @default("itcycle") @map("electronic_invoicing_provider")
  factusNumberingRangeId           String?            @map("factus_numbering_range_id")
  // Factus requires a distinct numbering range per document type (invoices
  // are document code 21, credit notes are 22) - they cannot share a range.
  factusCreditNoteNumberingRangeId String?            @map("factus_credit_note_numbering_range_id")
  factusDocumentType               String             @default("01") @map("factus_document_type")
  factusOperationType              String             @default("10") @map("factus_operation_type")
  factusPaymentForm                String             @default("1") @map("factus_payment_form")
  factusPaymentMethodCode          String             @default("42") @map("factus_payment_method_code")
  // Alanube (Alegra's e-provider API) requires each company to be registered
  // separately under its own NIT - there is no shared-account/branch model
  // like Factus's numbering ranges. taxIdentificationDv is the DIAN check
  // digit, auto-computed from taxIdentification (see nit.util.js) unless the
  // admin overrides it.
  taxIdentification                String?            @map("tax_identification")
  taxIdentificationDv              String?            @map("tax_identification_dv")
  alanubeCompanyId                 String?            @map("alanube_company_id")
  // DIAN test-set id used to enable the company for a document type.
  // Sandbox uses Alanube's published constant by default; production
  // requires the real id DIAN issues once habilitación is completed.
  alanubeTestSetId                 String?            @map("alanube_test_set_id")
  // Numbering authorization (DIAN "resolución de numeración"): resolutionNumber,
  // prefix, minNumber, maxNumber, startDate, endDate, technicalKey. Stored as
  // JSON rather than flat columns since it's fetched verbatim from Alanube's
  // getResolutions endpoint in production, or entered from DIAN's sandbox
  // example values for testing.
  alanubeInvoiceResolution         Json?              @map("alanube_invoice_resolution")
  alanubeCreditNoteResolution      Json?              @map("alanube_credit_note_resolution")
  // Unlike Factus, Alanube requires the caller to supply the next document
  // number itself (no server-side auto-numbering) - these track the next
  // number to use inside the resolution's [minNumber, maxNumber] range.
  // Null means "not started yet, seed from resolution.minNumber".
  alanubeNextInvoiceNumber         Int?               @map("alanube_next_invoice_number")
  alanubeNextCreditNoteNumber      Int?               @map("alanube_next_credit_note_number")
  // itcycle-api-dian ("software propio", see itcycleDian.service.js): the
  // company's id in that system's own database (created via its admin
  // provisioning API, not shared with Ohnix's own Company.id) and the API
  // key it issued for that company, encrypted at rest (secretEncryption.js)
  // - the raw key only ever exists in memory for the duration of a single
  // request, never as a plain column. Unlike Factus/Alanube (one shared
  // Ohnix-wide credential), itcycle-api-dian issues one key per company by
  // design, so each company needs its own here.
  itcycleCompanyId                 String?            @map("itcycle_company_id")
  itcycleApiKeyCiphertext          String?            @map("itcycle_api_key_ciphertext") @db.Text
  // The DIAN-issued Software ID this company's habilitación (software propio)
  // was registered under - NOT a secret (unlike softwarePin/technicalKey,
  // which stay solely in itcycle-api-dian's own DianConfiguration and are
  // never sent back here). Kept only so RegisteredConfigSummary can show the
  // owner what itcycle-api-dian actually has on file, matching legalName/NIT.
  dianSoftwareId                   String?            @map("dian_software_id")
  // Set only while this company's own DIAN "habilitación" (software propio)
  // is still "En proceso" - the DIAN sandbox rejects every send() unless it
  // carries this exact testSetId with method "SendTestSetAsync" (dian-kit's
  // default is the production method, SendBillSync, which the sandbox
  // refuses outright until DIAN approves the software). Null once DIAN
  // approves the habilitación - clear it then so issuance falls back to the
  // production method automatically.
  itcycleTestSetId                 String?            @map("itcycle_test_set_id")
  // Nómina electrónica has its OWN, separate DIAN habilitación from
  // invoicing's (own set de pruebas, own TestSetID) - a distinct field is
  // required rather than reusing itcycleTestSetId above: a company can be
  // fully live in production for invoicing (itcycleTestSetId already null)
  // while nómina is still mid-habilitación, or vice versa. Reusing the same
  // field would have made electronicPayroll.service.js's SendTestSetAsync
  // silently apply to invoicing traffic too (or the reverse) - same
  // "set only while En proceso, then null" admin-managed lifecycle as
  // itcycleTestSetId.
  itcyclePayrollTestSetId          String?            @map("itcycle_payroll_test_set_id")
  // FirmaPass validation UUID this company has claimed (via order-number
  // lookup or pasting the UUID FirmaPass gave them directly) - set once, on
  // first successful self-service action against a UUID, and enforced on
  // every later one. Without this, any authenticated company could read or
  // drive ANY other company's FirmaPass validation just by knowing/guessing
  // its UUID, since FirmaPass's own API has no per-company scoping at all
  // (see firmaPassProvisioning.service.js - this is a security boundary
  // Ohnix has to enforce itself, not one FirmaPass provides).
  firmaPassValidationUuid          String?            @unique @map("firmapass_validation_uuid")
  // Order PDF branding (Negocio+): logo + legal data replace the generic
  // template. pdfFooterText is the Escala+ "personalizable" extra.
  logoUrl                          String?            @map("logo_url") @db.Text
  pdfFooterText                    String?            @map("pdf_footer_text") @db.Text
  // Escala+ brand color (hex, e.g. "#29D8D5") applied to the PDF's accent
  // line/TOTAL amount in place of the fixed default, completing the "fully
  // customizable" PDF promise alongside logo + footer.
  pdfAccentColor                   String?            @map("pdf_accent_color")
  // VAT responsibility (ET art. 437) is a fact about the company, not a
  // billing setting - it belongs next to countryCode, not inside the DIAN/
  // Factus block below, since it also gates local (non-electronic) order
  // totals in order.service.js. vatResponsibleEffectiveFrom records when the
  // current status started applying, so a later status change never rewrites
  // the tax treatment of orders already placed before it.
  vatResponsible                   VatResponsibility  @default(unset) @map("vat_responsible")
  vatResponsibleEffectiveFrom      DateTime?          @map("vat_responsible_effective_from")
  // Income-tax regime (Ordinario vs RST) - see TaxRegime's comment. Null
  // until set; rentaDeclaration.service.js refuses to estimate a tax
  // liability while this is null, same "configure before we calculate"
  // posture as vatResponsible being `unset` by default.
  taxRegime                        TaxRegime?         @map("tax_regime")
  // Only meaningful (and required by rentaDeclaration.service.js) when
  // taxRegime is `simple` - selects which SimpleRegimeBracket table applies.
  simpleRegimeGroup                SimpleRegimeGroup? @map("simple_regime_group")
  // Withholding-agent status (agente retenedor de renta) - same shape and
  // "effective from" convention as vatResponsible above, but this is
  // CONFIGURATION only: no automatic retención en la fuente calculation
  // reads these fields yet (see accountingPosting.service.js's scope note).
  // Storing it now lets a company record the fact - and have it reviewed by
  // their accountant - ahead of that calculation engine existing.
  isWithholdingAgent               Boolean            @default(false) @map("is_withholding_agent")
  withholdingAgentEffectiveFrom    DateTime?          @map("withholding_agent_effective_from")
  // ReteICA config: unlike IVA/Retefuente, the applicable rate is set by
  // each municipality's own acuerdo for a given economic activity (CIIU) -
  // there's no national default to fall back to, so this is captured as a
  // plain per-company fact the user enters (ideally with their accountant),
  // not derived from anything else in the system. Same "configuration only,
  // no calculation yet" scope as isWithholdingAgent above.
  icaMunicipalityCode              String?            @map("ica_municipality_code")
  icaActivityCode                  String?            @map("ica_activity_code")
  icaRatePerThousand               Decimal?           @map("ica_rate_per_thousand") @db.Decimal(6, 3)
  // Ley 1819/2016 exoneración de aportes: whether THIS company qualifies for
  // the exemption regime at all (declarante de renta, not a natural person
  // employing fewer than 2 workers) - same "configuration fact the user
  // enters, ideally with their accountant" convention as isWithholdingAgent
  // above. The per-EMPLOYEE part of the rule (only wages under 10 SMLMV
  // qualify) is evaluated at calculation time, not stored here - see
  // payroll.service.js#calculatePayrollDocument.
  payrollAportesExonerados         Boolean            @default(false) @map("payroll_aportes_exonerados")
  isActive                         Boolean            @default(true) @map("is_active")
  createdAt                        DateTime           @default(now()) @map("created_at")
  updatedAt                        DateTime           @updatedAt @map("updated_at")

  users                        User[]
  electronicInvoices           ElectronicInvoice[]
  purchaseSupportDocuments     PurchaseSupportDocument[]
  receivedInvoiceReceipts      ReceivedInvoiceReceipt[]
  apiKeys                      ApiKey[]
  dianTestMatrixRuns           DianTestMatrixRun[]
  certificateOrders            CertificateOrder[]
  electronicPayrollDocuments   ElectronicPayrollDocument[]
  electronicPayrollAdjustments ElectronicPayrollAdjustment[]

  @@map("companies")
}

model ApiKey {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  companyId       String?   @map("company_id")
  name            String
  // Only the prefix is stored in plaintext (shown to the user to tell keys
  // apart); the full key is only ever shown once, at creation time.
  keyPrefix       String    @map("key_prefix")
  keyHash         String    @map("key_hash")
  // Granular permissions (see middleware/apiScopes.middleware.js), e.g.
  // ["products:read","orders:write"]. Every key created before scopes
  // existed is backfilled to the full legacy set (see the
  // add_ecommerce_integration_platform migration) so existing integrations
  // keep working unchanged; new keys default to an empty array (no access
  // to anything) until the owner explicitly picks scopes at creation time.
  scopes          String[]  @default([])
  requestsToday   Int       @default(0) @map("requests_today")
  requestsResetAt DateTime  @default(now()) @map("requests_reset_at")
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@unique([keyHash])
  @@index([userId])
  @@map("api_keys")
}

model PlanUpgradeRequest {
  id               String               @id @default(cuid())
  userId           String               @map("user_id")
  currentPlan      PlanType             @map("current_plan")
  targetPlan       PlanType             @map("target_plan")
  status           UpgradeRequestStatus @default(open)
  notes            String?              @db.Text
  adminResponse    String?              @map("admin_response") @db.Text
  paymentLink      String?              @map("payment_link") @db.Text
  paymentProvider  String?              @map("payment_provider")
  paymentSessionId String?              @unique @map("payment_session_id")
  paymentStatus    String?              @map("payment_status")
  // Null = unknown/not tracked (every row created before this column
  // existed). Set explicitly (true/false) once we actually learn it - from
  // ePayco's own x_test_request flag on the confirmation webhook or a live
  // transaction query, or from which Stripe key mode processed it - never
  // just assumed from today's env config, since that can flip between when
  // a request was created and when its payment actually resolved.
  isTestPayment    Boolean?             @map("is_test_payment")
  // What this specific request is billing for - drives both the checkout
  // amount (getAmountForPlanAndCurrency multiplies by 10 for ANNUAL) and the
  // period length closeApprovedRequestAndActivatePlan grants (30 vs 365
  // days). Read from the DB row, never trusted from a payment provider's
  // webhook payload - same "truth lives here, not in the callback" pattern
  // already used for targetPlan.
  billingCycle     BillingCycle         @default(MONTHLY) @map("billing_cycle")
  paidAt           DateTime?            @map("paid_at")
  // What was actually charged for this request, captured only once
  // paymentStatus becomes "paid" (alongside periodStartsAt/periodEndsAt
  // below). Amounts aren't stored anywhere else in this schema - every
  // checkout recomputes from the live STRIPE_AMOUNT_*/EPAYCO_AMOUNT_* env
  // vars - so without this snapshot, support has no way to reconstruct what
  // a customer actually paid once those env vars move on to a new price.
  paidAmount       Int?                 @map("paid_amount")
  paidCurrency     String?              @map("paid_currency")
  // Snapshot of the subscription period THIS request activated, taken at
  // the moment it did - the Subscription's own `endsAt` gets overwritten on
  // every renewal, so without this a closed/paid request from a few
  // renewals ago has no way to say what period it actually covered. Only
  // set when this request's payment was confirmed (paymentStatus "paid");
  // null on every other outcome.
  periodStartsAt   DateTime?            @map("period_starts_at")
  periodEndsAt     DateTime?            @map("period_ends_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("plan_upgrade_requests")
}

// A one-off Viafirma digital-certificate purchase (1 or 2 years), gating
// companySelf.controller.js#createMyViafirmaRequest per DIAN's requirement
// that the certificate be paid for before a request can be submitted -
// see certificateOrder.service.js#requireActiveCertificateEntitlement. Not
// folded into PlanUpgradeRequest: that model is subscription-shaped
// (currentPlan/targetPlan/admin review) and this is a standalone purchase
// with no admin approval step, so most of its columns would sit unused.
// Same ePayco checkout/webhook shape as PlanUpgradeRequest on purpose - see
// services/certificateOrderPayment.service.js, which mirrors epayco.service.js.
model CertificateOrder {
  id                  String    @id @default(cuid())
  companyId           String    @map("company_id")
  requestedByUserId   String    @map("requested_by_user_id")
  // Fixed at Viafirma's own certificate validity (see
  // ViafirmaCertificateProvider - every profile issues a 730-day/2-year
  // certificate regardless of what's paid for). A "1 año" purchase buys a
  // shorter Ohnix-side entitlement window on top of the same 2-year
  // certificate, not a technically different certificate - the customer
  // must pay again after 1 year to keep using it, even though the
  // underlying Viafirma certificate itself is still technically valid.
  durationYears       Int       @map("duration_years")
  amount              Int
  currency            String    @default("COP")
  paymentProvider     String?   @default("epayco") @map("payment_provider")
  paymentSessionId    String?   @unique @map("payment_session_id")
  // pending -> paid | rejected | failed | expired | cancelled | amount_mismatch
  // Same vocabulary as PlanUpgradeRequest.paymentStatus/handleEpaycoConfirmation.
  paymentStatus       String    @default("pending") @map("payment_status")
  isTestPayment       Boolean?  @map("is_test_payment")
  paidAt              DateTime? @map("paid_at")
  paidAmount          Int?      @map("paid_amount")
  paidCurrency        String?   @map("paid_currency")
  // The window during which createMyViafirmaRequest is allowed - starts at
  // paidAt, ends durationYears later. Once entitlementEndsAt lapses, the
  // company must create (and pay for) a new CertificateOrder before
  // requesting another certificate ("si se le vence otra vez debería volver
  // a salir para pagar y solicitar otro").
  entitlementStartsAt DateTime? @map("entitlement_starts_at")
  entitlementEndsAt   DateTime? @map("entitlement_ends_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company         Company @relation(fields: [companyId], references: [id])
  requestedByUser User    @relation(fields: [requestedByUserId], references: [id])

  @@index([companyId, paymentStatus])
  @@map("certificate_orders")
}

// A company with NO Ohnix account/Company row - their own POS/ERP/SaaS -
// that wants to integrate itcycle-api-dian's DIAN e-invoicing engine
// directly via API, bypassing Ohnix's own app entirely. Distinct from
// Company: this row is Ohnix-side bookkeeping only (who did an Ohnix admin
// provision on itcycle-api-dian, and when), never a tenant of Ohnix itself.
// Deliberately carries NO api-key column of any kind (encrypted or not) -
// unlike Company.itcycleApiKeyCiphertext, Ohnix's backend never needs to
// call itcycle-api-dian on this client's behalf, so there is nothing here
// for it to decrypt and reuse later. See
// Backend/services/externalApiClient.service.js.
model ExternalApiClient {
  id                  String   @id @default(cuid())
  companyName         String   @map("company_name")
  taxIdentification   String   @map("tax_identification")
  taxIdentificationDv String   @map("tax_identification_dv")
  personType          String   @map("person_type")
  contactName         String?  @map("contact_name")
  contactEmail        String?  @map("contact_email")
  contactPhone        String?  @map("contact_phone")
  notes               String?  @db.Text
  // itcycle-api-dian's own company id (from provisionItcycleCompany) - the
  // credential this client actually integrates against lives entirely on
  // itcycle-api-dian's side from here on.
  itcycleCompanyId    String   @unique @map("itcycle_company_id")
  createdByUserId     String   @map("created_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // epaycoCustomerId/epaycoTokenCard are ePayco's own opaque reference ids
  // (returned after the client tokenizes their card client-side, straight to
  // ePayco's servers - see EnrollApiBilling.jsx) - never raw card data, same
  // trust model as itcycleCompanyId itself. Safe to store as plain columns.
  epaycoCustomerId                String?   @map("epayco_customer_id")
  epaycoTokenCard                 String?   @map("epayco_token_card")
  billingEnrolledAt               DateTime? @map("billing_enrolled_at")
  // Single-use, short-lived link token for the card-enrollment page - never
  // an auth credential by itself (it only ever lets the holder submit an
  // already-tokenized card for THIS client), cleared once enrollment
  // completes or left to expire.
  billingEnrollmentToken          String?   @unique @map("billing_enrollment_token")
  billingEnrollmentTokenExpiresAt DateTime? @map("billing_enrollment_token_expires_at")
  // Annual base package ($310.000 COP / 100 documents by default, see
  // FacturacionSinInventario.jsx) - charged once per period by
  // apiClientBillingScheduler.js, which then only charges the overage beyond
  // annualDocsIncluded each month via cumulativeDocsThisPeriod.
  annualPeriodStartsAt            DateTime? @map("annual_period_starts_at")
  annualPeriodEndsAt              DateTime? @map("annual_period_ends_at")
  annualDocsIncluded              Int       @default(100) @map("annual_docs_included")
  annualBaseAmountCop             Int       @default(310000) @map("annual_base_amount_cop")
  cumulativeDocsThisPeriod        Int       @default(0) @map("cumulative_docs_this_period")
  // Set (and left set) the moment any automatic charge fails - the monthly
  // scheduler skips a client in this state on later runs rather than
  // retrying blindly, until an admin investigates and clears it by hand.
  billingAtRisk                   Boolean   @default(false) @map("billing_at_risk")
  // An external API client has no Ohnix account/login at all (see this
  // model's own top comment) - its contactEmail is the only channel to
  // occasionally offer it the full Ohnix SaaS (inventory, orders, etc.)
  // alongside the API-only relationship it already has. Admin-triggered only
  // (sendExternalClientUpsellEmail), never automatic - tracked here just so
  // the admin UI can show "last invited on X" and avoid re-sending too often.
  upsellEmailSentAt               DateTime? @map("upsell_email_sent_at")

  createdByUser   User                           @relation(fields: [createdByUserId], references: [id])
  apiKeyIssuances ExternalApiClientKeyIssuance[]
  charges         ExternalApiClientCharge[]

  @@map("external_api_clients")
}

// One row per attempted automatic charge (annual base package or a month's
// document overage) - the audit trail apiClientBillingScheduler.js writes to
// on every run, success or failure, so ops can reconcile against ePayco and
// see exactly what was billed and when without re-deriving it from usage
// counts after the fact.
model ExternalApiClientCharge {
  id                  String   @id @default(cuid())
  externalApiClientId String   @map("external_api_client_id")
  chargeType          String   @map("charge_type") // "annual_base" | "monthly_overage"
  periodYear          Int      @map("period_year")
  periodMonth         Int?     @map("period_month") // null for annual_base
  documentsCharged    Int?     @map("documents_charged") // null for annual_base
  amountCop           Int      @map("amount_cop")
  epaycoRef           String?  @map("epayco_ref") // ePayco's own transaction/ref id, for reconciliation
  status              String // "success" | "failed"
  errorMessage        String?  @map("error_message") @db.Text
  chargedAt           DateTime @default(now()) @map("charged_at")

  externalApiClient ExternalApiClient @relation(fields: [externalApiClientId], references: [id])

  @@index([externalApiClientId])
  @@map("external_api_client_charges")
}

// An audit trail of "a raw itcycle-api-dian API key was issued for this
// external client, by this admin, at this time" - deliberately NEVER the key
// value itself (see issueApiKeyForExternalClient's own comment). The raw key
// is shown to the admin exactly once in the API response/UI and then gone
// for good, same as itcycle-api-dian's own one-time reveal for Company.
model ExternalApiClientKeyIssuance {
  id                  String   @id @default(cuid())
  externalApiClientId String   @map("external_api_client_id")
  label               String?
  issuedByUserId      String   @map("issued_by_user_id")
  issuedAt            DateTime @default(now()) @map("issued_at")

  externalApiClient ExternalApiClient @relation(fields: [externalApiClientId], references: [id])
  issuedByUser      User              @relation(fields: [issuedByUserId], references: [id])

  @@index([externalApiClientId])
  @@map("external_api_client_key_issuances")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique @map("user_id")
  plan              PlanType           @default(starter)
  status            SubscriptionStatus @default(active)
  startedAt         DateTime           @default(now()) @map("started_at")
  endsAt            DateTime?          @map("ends_at")
  trialEndsAt       DateTime?          @map("trial_ends_at")
  // When true, the user asked to cancel but keeps `status: active` and full
  // plan access until `endsAt` - subscriptionRenewalScheduler's expiry job
  // then blocks access (status: "paused") the same as any other lapsed,
  // non-renewed period. Correction to what this comment used to claim:
  // `plan` is NEVER auto-changed to starter anywhere in this codebase - the
  // scheduler deliberately leaves it untouched so reactivating resumes the
  // same plan (see setMyStatus). scheduledPlan below is the one exception,
  // and only because it's set on purpose.
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  // Set by the self-service "bajar de plan" flow (never by an upgrade) -
  // the customer keeps full access to their current (higher) plan through
  // `endsAt`, no proration, no immediate charge (this system has no stored
  // payment method to auto-bill anyway - every renewal is a manual
  // checkout). Once `endsAt` lapses, blockLapsedSubscriptions applies this
  // to `plan` and clears it, so the next time they pay, it's for the lower
  // plan they actually asked for instead of silently re-billing the higher
  // one. Mutually exclusive with a full cancellation in intent, not in
  // storage - see downgradeMySubscription/undoMyDowngrade.
  scheduledPlan     PlanType?          @map("scheduled_plan")
  // Current billing cycle - MONTHLY (30-day periods, default/legacy) or
  // ANNUAL ("paga 10, lleva 12", 365-day periods, amount = monthly x10).
  // This is the account's *standing* cycle (used by createRenewalCheckout to
  // decide what the next auto-renewal should charge/grant), separate from
  // PlanUpgradeRequest.billingCycle which is what one specific request billed
  // for - kept in sync on every activation in closeApprovedRequestAndActivatePlan.
  billingCycle      BillingCycle       @default(MONTHLY) @map("billing_cycle")
  // Account-wide low-stock alert threshold (Escala+ feature, gated the same
  // way as Product.lowStockThreshold below) - null means "no override, fall
  // back to the platform-wide SystemSetting.lowStockDefaultThreshold". This
  // sits between the per-product threshold and that global admin default:
  // Product.lowStockThreshold ?? Subscription.lowStockThreshold ?? platform
  // default. See lowStockScheduler.js#getLowStockProductsForUser.
  lowStockThreshold Int?               @map("low_stock_threshold")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

// Every consequential admin-panel action on a customer's billing/plan
// (cancel/extend/uncancel a subscription, force-reverify a payment, hand-set
// a plan, approve/close an upgrade request) writes one row here - before
// this model, "who did that and when" existed nowhere: the admin's name was
// only ever used to word the customer-facing notification email, never
// actually persisted. targetUserId is nullable because not every audited
// action has a clear single target (kept generic on purpose so this covers
// whatever admin action needs logging next, not just subscriptions).
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String   @map("admin_id")
  action       String
  targetType   String   @map("target_type")
  targetId     String?  @map("target_id")
  targetUserId String?  @map("target_user_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  admin      User  @relation("AdminAuditLogAdmin", fields: [adminId], references: [id])
  targetUser User? @relation("AdminAuditLogTarget", fields: [targetUserId], references: [id])

  @@index([targetUserId, createdAt])
  @@index([adminId, createdAt])
  @@map("admin_audit_logs")
}

model Category {
  id             String   @id @default(cuid())
  legacyMongoId  String?  @unique @map("legacy_mongo_id")
  categoryName   String   @map("category_name")
  // Created by the interactive "how does Ohnix work" tour as practice data -
  // see tutorialData.service.js, the only thing that ever deletes these.
  isTutorialData Boolean  @default(false) @map("is_tutorial_data")
  createdById    String   @map("created_by")
  updatedById    String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  createdBy User      @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  products  Product[]

  // Backstop for the duplicate-name check in category.controller.js, which
  // reads-then-writes and so cannot rule out two concurrent renames to the
  // same name on its own - see the multi-user concurrency audit (2026-08-20).
  @@unique([categoryName, createdById])
  @@index([createdById])
  @@map("categories")
}

model Unit {
  id             String   @id @default(cuid())
  legacyMongoId  String?  @unique @map("legacy_mongo_id")
  unitName       String   @map("unit_name")
  isTutorialData Boolean  @default(false) @map("is_tutorial_data")
  createdById    String   @map("created_by")
  updatedById    String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  createdBy              User      @relation("UnitCreatedBy", fields: [createdById], references: [id])
  updatedBy              User?     @relation("UnitUpdatedBy", fields: [updatedById], references: [id])
  products               Product[]
  productsAsPurchaseUnit Product[] @relation("ProductPurchaseUnit")

  // See Category's matching constraint - same duplicate-name race, same fix.
  @@unique([unitName, createdById])
  @@index([createdById])
  @@map("units")
}

model Supplier {
  id                         String   @id @default(cuid())
  legacyMongoId              String?  @unique @map("legacy_mongo_id")
  name                       String
  email                      String
  phone                      String
  address                    String
  shopname                   String?
  type                       String?
  bankName                   String?  @map("bank_name")
  accountHolder              String?  @map("account_holder")
  accountNumber              String?  @map("account_number")
  photo                      String
  // Same DIAN fields/names as Customer's own block below, so
  // electronicInvoicing.service.js's buildItcycleCustomerParty/
  // buildItcyclePartyAddress work against a Supplier row unchanged.
  identificationDocumentCode String?  @map("identification_document_code")
  identification             String?  @map("identification")
  legalOrganizationCode      String?  @map("legal_organization_code")
  tributeCode                String?  @map("tribute_code")
  municipalityCode           String?  @map("municipality_code")
  countryCode                String?  @map("country_code")
  // Precondition for auto-issuing a Documento Soporte on purchase completion
  // (purchaseSupportDocument.service.js) - mirrors how order.orderStatus
  // "completed" gates sales invoicing. Only suppliers legally NOT required
  // to issue their own invoice need this document.
  notObligatedToInvoice      Boolean  @default(false) @map("not_obligated_to_invoice")
  // Opposite end of the same fork as notObligatedToInvoice: this supplier
  // issues its OWN real DIAN electronic invoice (UBL type "01"), so Ohnix's
  // customer (the buyer) owes DIAN an acuse de recibo / recibo del bien /
  // aceptación / reclamo referencing the SUPPLIER's CUFE (ET art. 616-1,
  // Ley 2155 de 2021 art. 13) - never a self-issued Documento Soporte.
  // Mutually exclusive with notObligatedToInvoice in practice (enforced in
  // supplier.service.js, not at the DB level, same pattern as that field).
  issuesElectronicInvoice    Boolean  @default(false) @map("issues_electronic_invoice")
  isTutorialData             Boolean  @default(false) @map("is_tutorial_data")
  createdById                String   @map("created_by")
  // Which location this supplier was created at - see Order.pointOfSaleId
  // for the pattern. Assigned once, at creation (resolveOrAssertPointOfSaleId),
  // same as orders/purchases; a restricted-scope member at another location
  // never sees this supplier, even to buy from it (2026-08-21 scope
  // decision: "por creación", not a shared directory).
  pointOfSaleId              String   @map("point_of_sale_id")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  createdBy      User                   @relation(fields: [createdById], references: [id])
  pointOfSale    PointOfSale            @relation(fields: [pointOfSaleId], references: [id])
  purchases      Purchase[]
  paymentCredits PaymentCreditBalance[]
  quotations     PurchaseQuotation[]

  @@index([createdById])
  @@index([pointOfSaleId])
  @@map("suppliers")
}

model Customer {
  id                         String   @id @default(cuid())
  legacyMongoId              String?  @unique @map("legacy_mongo_id")
  name                       String
  email                      String
  phone                      String
  address                    String?
  type                       String   @default("regular")
  storeName                  String?  @map("store_name")
  accountHolder              String?  @map("account_holder")
  accountNumber              String?  @map("account_number")
  photo                      String
  identificationDocumentCode String?  @map("identification_document_code")
  identification             String?  @map("identification")
  legalOrganizationCode      String?  @map("legal_organization_code")
  tributeCode                String?  @map("tribute_code")
  municipalityCode           String?  @map("municipality_code")
  countryCode                String?  @map("country_code")
  // Fixed withholding rates (retenciones) this customer applies when paying
  // Ohnix's DIAN invoices - set only when the customer is a known
  // self-withholding agent ("agente autorretenedor"), typically only for B2B
  // buyers, never for walk-in/regular retail customers. Null means "no
  // retention" - this is deliberately a flat configured rate, not an
  // automatic DIAN concept/UVT rules engine (those depend on transaction
  // concept and thresholds this system doesn't model). Named after
  // WithholdingTaxType (income/vat/ica) for consistency with
  // PurchaseRetention/WithholdingConcept below - same tax mechanism, the
  // opposite direction (what a customer withholds paying Ohnix, not what
  // Ohnix withholds paying a supplier), so no ChartAccount/journal entry of
  // Ohnix's own is needed here - that's the customer's own bookkeeping.
  // withholdingIncomePercent/withholdingIcaPercent apply to the pre-tax sale
  // amount (WithholdingBaseType.subtotal); withholdingVatPercent applies to
  // the IVA amount itself (WithholdingBaseType.vat), not the sale amount -
  // see buildItcycleWithholdingTotals in electronicInvoicing.service.js.
  // 3 decimal places, not 2: real Colombian ICA rates routinely need this
  // precision (e.g. 0.966%, 0.414%) - Decimal(5,2) silently rounded 0.966 to
  // 0.97 (a real, different rate) the first time this was tested for real.
  withholdingIncomePercent   Decimal? @map("withholding_income_percent") @db.Decimal(6, 3)
  withholdingIcaPercent      Decimal? @map("withholding_ica_percent") @db.Decimal(6, 3)
  withholdingVatPercent      Decimal? @map("withholding_vat_percent") @db.Decimal(6, 3)
  isTutorialData             Boolean  @default(false) @map("is_tutorial_data")
  createdById                String   @map("created_by")
  // See Supplier.pointOfSaleId - same "assigned at creation" rule.
  pointOfSaleId              String   @map("point_of_sale_id")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  createdBy       User                   @relation(fields: [createdById], references: [id])
  pointOfSale     PointOfSale            @relation(fields: [pointOfSaleId], references: [id])
  orders          Order[]
  paymentCredits  PaymentCreditBalance[]
  salesQuotations SalesQuotation[]

  @@index([createdById])
  @@index([pointOfSaleId])
  @@map("customers")
}

model Product {
  id                           String              @id @default(cuid())
  legacyMongoId                String?             @unique @map("legacy_mongo_id")
  productName                  String              @map("product_name")
  productCode                  String              @map("product_code")
  // E-commerce-facing identifiers, independent of productCode (which
  // predates any channel-integration concept and is free-form/not always
  // unique in spirit). Both optional and nullable - most existing products
  // have neither yet. sku is unique per account when set (multiple NULLs
  // are allowed by Postgres's unique-index semantics).
  sku                          String?
  barcode                      String?
  brand                        String?
  // draft/archived exist for the e-commerce publishing flow (see
  // connectors/ - a product shouldn't be pushed to a channel until it's
  // "active", and "archived" hides it from new publishes without deleting
  // sale history). Every pre-existing product defaults to active so this
  // is a no-op for the POS-only flows that predate it.
  status                       ProductStatus       @default(active)
  categoryId                   String              @map("category_id")
  unitId                       String              @map("unit_id")
  // Optional alternate unit this product is BOUGHT in (e.g. "Caja") when it
  // differs from `unit` (the stock/sale unit, e.g. "Unidad") -
  // purchase.service.js converts a line entered in this unit into base-unit
  // quantity/cost before it ever reaches PurchaseDetail, so stock and
  // weighted-average costing never need to know a conversion happened. Both
  // columns are set together or not at all (enforced at the service layer,
  // not the DB) - a factor with no unit, or vice versa, means nothing.
  purchaseUnitId               String?             @map("purchase_unit_id")
  purchaseUnitConversionFactor Decimal?            @map("purchase_unit_conversion_factor") @db.Decimal(10, 2)
  buyingPrice                  Decimal             @map("buying_price") @db.Decimal(12, 2)
  sellingPrice                 Decimal             @map("selling_price") @db.Decimal(12, 2)
  // Account-wide total across every Point of Sale - a fast-read cache kept
  // in sync with ProductLocationStock the same way ProductLocationStock
  // itself is a fast-read cache in front of StockMovement (see that
  // model's comment). Always equals the sum of this product's
  // ProductLocationStock rows; never written directly except by that sync -
  // see productLocationStock.service.js#claimLocationStock.
  stock                        Int                 @default(0)
  productImage                 String              @default("default-product.png") @map("product_image")
  unitMeasureCode              String              @default("94") @map("unit_measure_code")
  standardCode                 String              @default("999") @map("standard_code")
  taxCode                      String?             @default("01") @map("tax_code")
  taxRate                      Decimal?            @default(0) @map("tax_rate") @db.Decimal(5, 2)
  // Replaces the old isTaxExcluded boolean - see ProductTaxTreatment for why
  // "excluded" and "exempt" can't be the same flag. taxRate keeps meaning
  // "the rate to charge when taxTreatment is taxed"; it's ignored for
  // excluded/exempt (exempt is always 0% by definition, ET art. 477/478/481).
  taxTreatment                 ProductTaxTreatment @default(taxed) @map("tax_treatment")
  // Per-product override for the low-stock alert threshold (Escala+ plan
  // feature). Null means "use the account-wide default threshold".
  lowStockThreshold            Int?                @map("low_stock_threshold")
  // A kit/combo never has its own ProductLocationStock row - selling one
  // claims stock from its `kitComponents` instead (order.service.js's
  // createOrder), scaled by each component's own quantity. `stock` above
  // stays 0 and unused for a kit, same "field allowed to be meaningless in
  // this one case" idiom as isPhysical's own block. No nested kits (a
  // kit's components must themselves be non-kit products) - enforced at
  // the service layer, not the DB, to keep the recursion this would
  // otherwise need out of both the schema and the sale-time stock claim.
  isKit                        Boolean             @default(false) @map("is_kit")
  // Opt-in lot/expiration tracking - mutually exclusive with isKit (a kit's
  // stock is virtual, there's nothing to lot-track) and, like isKit, only
  // togglable while stock is 0 (product.controller.js), since there's no
  // way to retroactively assign existing stock to a lot. When true, every
  // stock credit (purchase receipt, positive adjustment, inbound transfer)
  // must name a lot via productBatch.service.js#creditBatch, and every
  // debit (sale, negative adjustment, outbound transfer, purchase return)
  // consumes lots oldest-expiration-first via that same service's
  // claimBatchesFEFO - see ProductBatch's own comment for why this stays a
  // best-effort approximation on the return/cancel path rather than an
  // exact snapshot like costBasisApplied.
  tracksBatches                Boolean             @default(false) @map("tracks_batches")
  // Opt-in manufacturing: this product's stock is produced from a recipe
  // (recipeComponents, raw materials) via a ProductionOrder, instead of
  // (or in addition to) being purchased directly - mutually exclusive with
  // isKit (a kit has no real stock to produce into) but freely combinable
  // with tracksBatches (a production run can absolutely carry its own lot/
  // expiration, e.g. a bakery's daily batch). Same stock-guard as isKit/
  // tracksBatches: only togglable while stock is 0, enforced in
  // product.controller.js, since existing stock has no recipe history to
  // attribute it to.
  isManufactured               Boolean             @default(false) @map("is_manufactured")
  // Physical characteristics for shipping/logistics (see the WeightUnit
  // enum comment for the storage-vs-display-unit split). isPhysical
  // defaults true so every pre-existing product stays valid; a digital
  // good/service is the only case that sets it false, which is also the
  // only case where the rest of this block is allowed to be null.
  isPhysical                   Boolean             @default(true) @map("is_physical")
  weightValue                  Decimal?            @map("weight_value") @db.Decimal(10, 2)
  weightUnit                   WeightUnit          @default(g) @map("weight_unit")
  heightValue                  Decimal?            @map("height_value") @db.Decimal(10, 2)
  widthValue                   Decimal?            @map("width_value") @db.Decimal(10, 2)
  lengthValue                  Decimal?            @map("length_value") @db.Decimal(10, 2)
  dimensionUnit                DimensionUnit       @default(cm) @map("dimension_unit")
  // Derived from height/width/length by product.controller.js
  // (computeVolumetricWeightGrams) every time any of the three changes -
  // never a direct user input, so it can't drift from the dimensions it
  // was computed from. Divisor (5000 cm3/kg) is the standard used by every
  // major Colombian carrier (Servientrega, Coordinadora, Interrápidísimo,
  // TCC); a carrier-specific divisor belongs in that carrier's future
  // adapter, not here.
  volumetricWeight             Decimal?            @map("volumetric_weight") @db.Decimal(10, 2)
  // How many physical units make up one sellable/dispatched unit of this
  // product - e.g. a "six-pack" SKU where unitsPerPackage = 6. Doesn't
  // affect weight/dimensions (those already describe the dispatched
  // package), it's informational for whoever packs the order.
  unitsPerPackage              Int                 @default(1) @map("units_per_package")
  packagingType                PackagingType       @default(box) @map("packaging_type")
  isFragile                    Boolean             @default(false) @map("is_fragile")
  // Package-for-dispatch overrides. Null means "the dispatched package IS
  // the unit itself" (weightValue/height/width/lengthValue above already
  // describe it) - the common case of one unit = one box, which this way
  // doesn't force every seller to fill in the same numbers twice. Only set
  // when what actually ships differs from the bare unit (e.g. bundled with
  // extra packaging material).
  packageWeightValue           Decimal?            @map("package_weight_value") @db.Decimal(10, 2)
  packageHeightValue           Decimal?            @map("package_height_value") @db.Decimal(10, 2)
  packageWidthValue            Decimal?            @map("package_width_value") @db.Decimal(10, 2)
  packageLengthValue           Decimal?            @map("package_length_value") @db.Decimal(10, 2)
  isTutorialData               Boolean             @default(false) @map("is_tutorial_data")
  createdById                  String              @map("created_by")
  updatedById                  String?             @map("updated_by")
  createdAt                    DateTime            @default(now()) @map("created_at")
  updatedAt                    DateTime            @updatedAt @map("updated_at")

  category              Category                    @relation(fields: [categoryId], references: [id])
  unit                  Unit                        @relation(fields: [unitId], references: [id])
  purchaseUnit          Unit?                       @relation("ProductPurchaseUnit", fields: [purchaseUnitId], references: [id])
  createdBy             User                        @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?                       @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  orderDetails          OrderDetail[]
  purchaseDetails       PurchaseDetail[]
  quotationDetails      PurchaseQuotationDetail[]
  salesQuotationDetails SalesQuotationDetail[]
  stockMovements        StockMovement[]
  locationStock         ProductLocationStock[]
  transfers             StockTransfer[]
  images                ProductImage[]
  variants              ProductVariant[]
  kitComponents         ProductKitComponent[]       @relation("KitComponents")
  componentOfKits       ProductKitComponent[]       @relation("ComponentOfKits")
  batches               ProductBatch[]
  recipeComponents      ProductionRecipeComponent[] @relation("RecipeFor")
  usedInRecipes         ProductionRecipeComponent[] @relation("RecipeComponentOf")
  productionOrders      ProductionOrder[]           @relation("ProductionOrderProduct")
  productionOrderLines  ProductionOrderLine[]       @relation("ProductionOrderLineComponent")

  @@unique([productCode, createdById])
  @@unique([sku, createdById])
  @@index([createdById])
  @@index([categoryId])
  @@index([unitId])
  @@index([purchaseUnitId])
  @@map("products")
}

// One line of a kit/combo's recipe: selling `quantity` of `componentProductId`
// per unit of `kitProductId` sold - see Product.isKit's own comment. Kept as
// a flat list (no nested kits) so order.service.js#createOrder can resolve
// and claim every component's stock in one pass without recursion.
model ProductKitComponent {
  id                 String   @id @default(cuid())
  kitProductId       String   @map("kit_product_id")
  componentProductId String   @map("component_product_id")
  quantity           Decimal  @db.Decimal(10, 2)
  position           Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")

  kitProduct       Product @relation("KitComponents", fields: [kitProductId], references: [id], onDelete: Cascade)
  componentProduct Product @relation("ComponentOfKits", fields: [componentProductId], references: [id])

  @@unique([kitProductId, componentProductId])
  @@index([kitProductId, position])
  @@index([componentProductId])
  @@map("product_kit_components")
}

// One received lot of a tracksBatches product at one location - the
// per-(product, location, lot) counterpart to ProductLocationStock's
// per-(product, location) balance, kept purely as a quantity/expiration
// sub-ledger layered on top of it (cost stays entirely in
// ProductLocationStock's weighted average - a lot never carries its own
// cost). `quantity` is the lot's current remaining balance, credited on
// receipt (purchase, positive adjustment, inbound transfer) and debited
// FEFO (earliest expirationDate first, nulls last, then oldest first) on
// every sale/decrement - see productBatch.service.js. A null
// expirationDate means "this lot doesn't expire" and sorts last in FEFO
// order, never first.
//
// Deliberately NOT symmetric with returns/cancellations the way
// costBasisApplied is: reversing a sale/adjustment credits the returned
// quantity back to whichever lot currently expires soonest, not
// necessarily the exact lot it was claimed from. Exact per-line lot
// snapshotting (mirroring OrderDetail.costBasisApplied) would need a new
// JSON column on every detail table this touches (order, purchase,
// adjustment) for a return path that's comparatively rare - the same
// "simplify the reversal, keep the forward path exact" tradeoff already
// made for kit returns (see Product.isKit's own comment).
model ProductBatch {
  id             String    @id @default(cuid())
  productId      String    @map("product_id")
  pointOfSaleId  String    @map("point_of_sale_id")
  batchNumber    String    @map("batch_number")
  expirationDate DateTime? @map("expiration_date")
  quantity       Int       @default(0)
  createdById    String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product     Product     @relation(fields: [productId], references: [id])
  pointOfSale PointOfSale @relation(fields: [pointOfSaleId], references: [id])
  createdBy   User        @relation(fields: [createdById], references: [id])

  @@unique([productId, pointOfSaleId, batchNumber])
  @@index([productId, pointOfSaleId, expirationDate])
  @@map("product_batches")
}

// One raw-material line of a manufactured product's recipe - the
// production counterpart to ProductKitComponent, but consumed at
// PRODUCTION time (a discrete, user-triggered ProductionOrder) rather than
// at sale time, and against a component that has its own real stock (no
// "no nested manufacturing" restriction the way kits block nested kits -
// there's no recursive derivation to protect against here, a multi-level
// BOM just means the sub-assembly was produced by its own earlier
// ProductionOrder and already has ordinary stock to consume).
model ProductionRecipeComponent {
  id                 String   @id @default(cuid())
  productId          String   @map("product_id")
  componentProductId String   @map("component_product_id")
  quantity           Decimal  @db.Decimal(10, 2)
  position           Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")

  product          Product @relation("RecipeFor", fields: [productId], references: [id], onDelete: Cascade)
  componentProduct Product @relation("RecipeComponentOf", fields: [componentProductId], references: [id])

  @@unique([productId, componentProductId])
  @@index([productId, position])
  @@index([componentProductId])
  @@map("production_recipe_components")
}

enum ProductionOrderStatus {
  draft
  completed
  cancelled
}

// A single manufacturing run: produce `quantity` of `product` at
// `pointOfSale`, consuming its recipe (ProductionRecipeComponent) scaled by
// that quantity. Stays a no-op for stock/accounting while `draft` (lines
// below are a snapshot of what WILL be consumed, not yet claimed) - only
// the draft -> completed transition actually moves anything, same
// "review, then commit" shape purchases/orders already use for their own
// pending -> completed transition. completed -> cancelled reverses it
// (production.service.js#cancelProductionOrder), guarded the same way
// every other reversal in this codebase is: fails if the produced quantity
// isn't still fully on hand (already sold/transferred/consumed by another
// order) rather than silently going negative.
model ProductionOrder {
  id                  String                @id @default(cuid())
  productId           String                @map("product_id")
  pointOfSaleId       String                @map("point_of_sale_id")
  quantity            Int
  status              ProductionOrderStatus @default(draft)
  // Entered by the user, applied to the finished product's cost on
  // completion (see accountingPosting.service.js#postProductionJournalEntry)
  // - unlike materialsCost below, these never change once the order is
  // completed (there's no "current cost" to re-derive them from the way
  // materials have a live weighted-average).
  laborCost           Decimal               @default(0) @map("labor_cost") @db.Decimal(12, 2)
  overheadCost        Decimal               @default(0) @map("overhead_cost") @db.Decimal(12, 2)
  // Sum of every line's actual consumed cost - 0 (meaningless) until
  // completion, when it's computed from each line's own weighted-average
  // claim, same "frozen at the moment it happened" convention as
  // OrderDetail.costBasisApplied.
  materialsCost       Decimal               @default(0) @map("materials_cost") @db.Decimal(12, 2)
  unitCostApplied     Decimal?              @map("unit_cost_applied") @db.Decimal(14, 4)
  // Only meaningful when `product.tracksBatches` - captured here at draft
  // time (same "state it once, at intake" reasoning as
  // PurchaseDetail.batchNumber) and applied to the finished product's own
  // lot at completion.
  batchNumber         String?               @map("batch_number")
  batchExpirationDate DateTime?             @map("batch_expiration_date")
  notes               String?               @db.Text
  completedAt         DateTime?             @map("completed_at")
  cancelledAt         DateTime?             @map("cancelled_at")
  createdById         String                @map("created_by")
  updatedById         String?               @map("updated_by")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  product     Product               @relation("ProductionOrderProduct", fields: [productId], references: [id])
  pointOfSale PointOfSale           @relation(fields: [pointOfSaleId], references: [id])
  createdBy   User                  @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?                 @relation("ProductionOrderUpdatedBy", fields: [updatedById], references: [id])
  lines       ProductionOrderLine[]

  @@index([createdById, status])
  @@index([productId])
  @@index([pointOfSaleId])
  @@map("production_orders")
}

// One raw-material line of a ProductionOrder - a snapshot of
// ProductionRecipeComponent at the moment the order was drafted
// (quantityRequired = recipe.quantity * order.quantity, rounded the same
// way ProductKitComponent's sale-time consumption is), so editing the
// product's recipe afterward never rewrites an order already in flight.
// unitCostApplied is null until completion.
model ProductionOrderLine {
  id                 String   @id @default(cuid())
  productionOrderId  String   @map("production_order_id")
  componentProductId String   @map("component_product_id")
  quantityRequired   Decimal  @map("quantity_required") @db.Decimal(12, 2)
  unitCostApplied    Decimal? @map("unit_cost_applied") @db.Decimal(14, 4)
  createdAt          DateTime @default(now()) @map("created_at")

  productionOrder  ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  componentProduct Product         @relation("ProductionOrderLineComponent", fields: [componentProductId], references: [id])

  @@index([productionOrderId])
  @@index([componentProductId])
  @@map("production_order_lines")
}

// One sellable combination of a product's options (e.g. "Negra / M" for a
// Camiseta with Color/Talla options) - see the e-commerce integration
// design. Each variant carries its own optional price/weight overrides
// (null = inherit the parent Product's) and its own stock cache.
//
// Deliberately account-wide, not yet split per PointOfSale the way
// ProductLocationStock splits Product.stock - this is the same
// "single-number cache first, multi-location later if it turns out to be
// needed" simplification Product.stock itself started with. The actual
// availability check for a real Ohnix POS sale still happens at the
// (product, location) level via ProductLocationStock/claimLocationStock,
// completely unchanged; a variant's own stock is a parallel, best-effort
// bookkeeping figure kept for channel sync/traceability purposes (see
// services/variant.service.js#claimVariantStock, called inside the same
// transaction right after the product-level claim already succeeded).
model ProductVariant {
  id           String        @id @default(cuid())
  productId    String        @map("product_id")
  sku          String?
  barcode      String?
  // Human-readable label built from `options` (e.g. "Negra / M") - stored
  // rather than derived so list/detail responses don't need to re-join
  // option definitions just to render a variant's name.
  optionsLabel String        @map("options_label")
  // Free-form option map, e.g. {"Color":"Negra","Talla":"M"} - no separate
  // ProductOption table in v1; a connector reads/writes this directly.
  options      Json
  sellingPrice Decimal?      @map("selling_price") @db.Decimal(12, 2)
  buyingPrice  Decimal?      @map("buying_price") @db.Decimal(12, 2)
  weightValue  Decimal?      @map("weight_value") @db.Decimal(10, 2)
  stock        Int           @default(0)
  status       ProductStatus @default(active)
  position     Int           @default(0)
  createdById  String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  stockMovements StockMovement[]
  orderDetails   OrderDetail[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

// Gallery entry for a product - Product.productImage stays a synced cache
// of whichever row here has isPrimary=true (see
// services/productImage.service.js#syncPrimaryScalar), so every existing
// reader of the scalar field (reports, bulk import defaults, the mapped API
// response) keeps working unchanged. isPrimary is always exactly
// `position === 0`; both are stored (rather than deriving isPrimary from a
// MIN(position) query) so the API response is self-explanatory, but every
// write goes through that one service so the two can't drift apart.
model ProductImage {
  id        String          @id @default(cuid())
  productId String          @map("product_id")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Null = a product-level gallery image (the pre-existing behavior).
  // Set = this image belongs to one specific variant (e.g. the "Negra"
  // photo for a Camiseta whose other images are shared across variants).
  // Still counted toward the same product's MAX_PRODUCT_IMAGES ceiling.
  variantId String?         @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  position  Int             @default(0)
  isPrimary Boolean         @default(false) @map("is_primary")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([productId, position])
  @@index([variantId])
  @@map("product_images")
}

// Per-location partition of a product's stock - the piece Product.stock
// alone can't answer once an account has more than one PointOfSale ("10 in
// Pereira, 25 in Bogotá"). Same fast-read-cache-in-front-of-a-ledger
// pattern as Product.stock itself: StockMovement (which already carries
// pointOfSaleId) is the append-only source of truth, this is the current
// balance for one (product, location) pair. A missing row for a given
// (productId, pointOfSaleId) means 0, not "unknown" - see
// productLocationStock.service.js#getOrCreate.
model ProductLocationStock {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  pointOfSaleId   String   @map("point_of_sale_id")
  stock           Int      @default(0)
  averageUnitCost Decimal  @default(0) @map("average_unit_cost") @db.Decimal(14, 4)
  inventoryValue  Decimal  @default(0) @map("inventory_value") @db.Decimal(16, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product     Product     @relation(fields: [productId], references: [id])
  pointOfSale PointOfSale @relation(fields: [pointOfSaleId], references: [id])

  @@unique([productId, pointOfSaleId])
  @@index([pointOfSaleId])
  @@map("product_location_stock")
}

enum StockTransferStatus {
  requested
  approved
  in_transit
  received
  cancelled
}

// A movement of one product between two of the account's locations,
// tracked through its own lifecycle rather than as a single instantaneous
// event - see the 2026-08-21 multi-location inventory spec. Stock only
// actually moves at two of the five states: approved -> in_transit claims
// quantitySent from fromPointOfSale's ProductLocationStock (the same
// atomic-claim guard as every other stock decrement - see
// stockTransfer.service.js), and in_transit -> received credits
// quantityReceived (not necessarily quantitySent - see discrepancy below)
// to toPointOfSale's. Between those two transitions the quantity is
// neither location's available stock: it's "in transit", computed as
// SUM(quantitySent) over in_transit rows destined for a location (see
// productLocationStock.service.js#getLocationStockSummary) rather than
// stored as a separate counter anywhere, so it can never drift from the
// transfers that actually produced it.
//
// isQuickTransfer collapses all four state transitions into one atomic
// step for a move that already happened physically and doesn't need the
// request/approve/ship workflow (stockTransfer.service.js#quickTransfer) -
// it still produces a full StockTransfer row (status jumps straight to
// received, quantityReceived = quantitySent, every *At timestamp equal) so
// it's traceable exactly like a workflowed transfer, never a shortcut that
// skips the ledger.
model StockTransfer {
  id                String              @id @default(cuid())
  accountId         String              @map("account_id")
  productId         String              @map("product_id")
  fromPointOfSaleId String              @map("from_point_of_sale_id")
  toPointOfSaleId   String              @map("to_point_of_sale_id")
  quantitySent      Int                 @map("quantity_sent")
  unitCostApplied   Decimal?            @map("unit_cost_applied") @db.Decimal(14, 4)
  // Null until received - filled in from the caller's count at receipt
  // time, which is allowed to differ from quantitySent (see the model
  // comment's "discrepancy" note). Never defaults to quantitySent on
  // receive; the receiving side must state what actually arrived.
  quantityReceived  Int?                @map("quantity_received")
  status            StockTransferStatus @default(requested)
  isQuickTransfer   Boolean             @default(false) @map("is_quick_transfer")
  notes             String?             @db.Text
  cancelReason      String?             @map("cancel_reason") @db.Text
  // Only set for a tracksBatches product - the exact per-lot breakdown
  // claimed at ship time ([{batchNumber, expirationDate, quantity}], see
  // productBatch.service.js#claimBatchesFEFO's return shape), reused at
  // receive time to credit the destination with the SAME lot identity
  // (not a fresh FEFO guess) and at cancel time to credit it straight back
  // to the source - same "freeze what was actually claimed, replay it on
  // reversal" idiom as unitCostApplied above, just structured instead of
  // scalar.
  batchAllocations  Json?               @map("batch_allocations")

  requestedById String    @map("requested_by")
  requestedAt   DateTime  @default(now()) @map("requested_at")
  approvedById  String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  sentById      String?   @map("sent_by")
  sentAt        DateTime? @map("sent_at")
  receivedById  String?   @map("received_by")
  receivedAt    DateTime? @map("received_at")
  cancelledById String?   @map("cancelled_by")
  cancelledAt   DateTime? @map("cancelled_at")

  product         Product     @relation(fields: [productId], references: [id])
  fromPointOfSale PointOfSale @relation("StockTransferFrom", fields: [fromPointOfSaleId], references: [id])
  toPointOfSale   PointOfSale @relation("StockTransferTo", fields: [toPointOfSaleId], references: [id])
  requestedBy     User        @relation("StockTransferRequestedBy", fields: [requestedById], references: [id])

  @@index([accountId, status])
  @@index([productId])
  @@index([fromPointOfSaleId, status])
  @@index([toPointOfSaleId, status])
  @@map("stock_transfers")
}

// The append-only ledger behind every Product.stock change. `stock` itself
// stays the fast-read current balance (unchanged), but every write path that
// touches it (purchase completion, sale completion, purchase return, sale
// cancellation, manual adjustment) must also insert one row here in the same
// transaction - see stockMovement.service.js's recordStockMovement, the
// single place that does so. `accountId` duplicates the owning product's
// createdById (the team/account scope, see teamContext.js) so history
// queries don't need to join through Product for tenant filtering.
model StockMovement {
  id                String                  @id @default(cuid())
  productId         String                  @map("product_id")
  accountId         String                  @map("account_id")
  // Which location this movement happened at - see Order.pointOfSaleId.
  // Stock itself (Product.stock) is not yet partitioned by location (that's
  // a later phase); this column only attributes history, so it can seed
  // per-location balances later without re-deriving them from scratch.
  pointOfSaleId     String                  @map("point_of_sale_id")
  // Set only when this movement is also (or exclusively, for a channel-sync
  // correction with no matching POS sale) tracking one variant's own stock
  // cache - see ProductVariant's schema comment. delta/balanceAfter always
  // describe whichever of Product.stock/ProductVariant.stock this specific
  // row is about; a variant-level order line writes two rows (one product-
  // scoped, one variant-scoped), not one row with both deltas mixed.
  variantId         String?                 @map("variant_id")
  delta             Int
  balanceAfter      Int                     @map("balance_after")
  unitCostApplied   Decimal?                @map("unit_cost_applied") @db.Decimal(14, 4)
  valueDelta        Decimal?                @map("value_delta") @db.Decimal(16, 2)
  valueBalanceAfter Decimal?                @map("value_balance_after") @db.Decimal(16, 2)
  sourceType        StockMovementSourceType @map("source_type")
  sourceId          String?                 @map("source_id")
  reason            String?                 @db.Text
  createdById       String                  @map("created_by")
  createdAt         DateTime                @default(now()) @map("created_at")

  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  pointOfSale PointOfSale     @relation(fields: [pointOfSaleId], references: [id])
  createdBy   User            @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([accountId, createdAt])
  @@index([sourceType, sourceId])
  @@index([pointOfSaleId, createdAt])
  @@map("stock_movements")
}

// Platform-wide knobs that used to live only in a process-memory singleton
// (LowStockScheduler.threshold) and drifted out of sync with the copies
// hardcoded in order.service.js and report.controller.js. Single row, fixed
// id - see systemSettings.util.js for the get/set helpers that keep it in
// sync across the weekly digest, the real-time post-sale alert, and reports.
model SystemSetting {
  id                                 String   @id @default("singleton")
  lowStockDefaultThreshold           Int      @default(10) @map("low_stock_default_threshold")
  // Colombia VAT config (ET art. 468 general rate, art. 437 par. 3 UVT
  // threshold, DIAN's yearly UVT peso value) - kept as data instead of the
  // hardcoded constants they replace (product.controller.js's old
  // COLOMBIA_DEFAULT_TAX_RATE = 19) because all three change by government
  // decree, not by a code deploy: the general rate has changed before (Ley
  // 1819/2016), and the UVT is republished by DIAN every December for the
  // following fiscal year (e.g. Resolución 000238 de 2025 set UVT 2026 at
  // $52.374). None of these are read automatically from DIAN - an admin
  // updates them here when the government publishes new values.
  colombiaVatRate                    Decimal  @default(19) @map("colombia_vat_rate") @db.Decimal(5, 2)
  colombiaVatResponsibleThresholdUvt Int      @default(3500) @map("colombia_vat_responsible_threshold_uvt")
  colombiaUvtValue                   Decimal  @default(52374) @map("colombia_uvt_value") @db.Decimal(12, 2)
  updatedAt                          DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// Turns a registered-but-not-yet-searched dimension in
// crossFactorCorrelation.detector.js's DIMENSION_REGISTRY on or off,
// globally, WITHOUT a deploy - see that file's header comment for why this
// exists (config-as-data instead of the detector writing its own code).
// Absence of a row for a given (detectorKey, dimensionKey) means "use that
// registry entry's own defaultEnabled" - so an empty table is identical to
// today's hardcoded behavior, no seed/migration data required for this to
// be safe on day one. dimensionKey must name an entry the code registry
// actually defines; this table can only narrow or widen WHICH of those
// already-reviewed extractors run, never add extraction logic of its own -
// that distinction is the whole safety argument for this being data, not
// code that writes itself.
model DiscoveryDimensionConfig {
  id           String   @id @default(cuid())
  detectorKey  String   @map("detector_key")
  dimensionKey String   @map("dimension_key")
  enabled      Boolean
  updatedById  String?  @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([detectorKey, dimensionKey])
  @@map("discovery_dimension_configs")
}

model Purchase {
  id             String         @id @default(cuid())
  legacyMongoId  String?        @unique @map("legacy_mongo_id")
  purchaseDate   DateTime       @default(now()) @map("purchase_date")
  dueDate        DateTime?      @map("due_date")
  purchaseNo     String         @unique @map("purchase_no")
  supplierId     String         @map("supplier_id")
  // Which location received this stock - see Order.pointOfSaleId.
  pointOfSaleId  String         @map("point_of_sale_id")
  purchaseStatus PurchaseStatus @default(pending) @map("purchase_status")
  isTutorialData Boolean        @default(false) @map("is_tutorial_data")
  createdById    String         @map("created_by")
  updatedById    String?        @map("updated_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  supplier                Supplier                    @relation(fields: [supplierId], references: [id])
  pointOfSale             PointOfSale                 @relation(fields: [pointOfSaleId], references: [id])
  createdBy               User                        @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  updatedBy               User?                       @relation("PurchaseUpdatedBy", fields: [updatedById], references: [id])
  purchaseDetails         PurchaseDetail[]
  payments                PurchasePayment[]
  paymentAllocations      PurchasePaymentAllocation[]
  purchaseSupportDocument PurchaseSupportDocument?
  receivedInvoiceReceipt  ReceivedInvoiceReceipt?
  // Back-relation for PurchaseQuotation.convertedPurchase - set only when
  // this Purchase was created by approving a quotation, never on a purchase
  // created directly.
  sourceQuotation         PurchaseQuotation?
  retentions              PurchaseRetention[]

  @@index([createdById])
  @@index([supplierId])
  @@index([pointOfSaleId])
  @@map("purchases")
}

// Immutable tax snapshot attached to the business document. The concept may
// later be deactivated or superseded, but this row preserves exactly what the
// purchase used. Returned amounts are running totals, mirroring
// PurchaseDetail.returnedQuantity/refundAmount for partial returns.
model PurchaseRetention {
  id                     String              @id @default(cuid())
  purchaseId             String              @map("purchase_id")
  conceptId              String?             @map("concept_id")
  conceptCode            String              @map("concept_code")
  conceptName            String              @map("concept_name")
  taxType                WithholdingTaxType  @map("tax_type")
  baseType               WithholdingBaseType @map("base_type")
  ratePercent            Decimal             @map("rate_percent") @db.Decimal(8, 4)
  minimumBaseAmount      Decimal             @map("minimum_base_amount") @db.Decimal(14, 2)
  baseAmount             Decimal             @map("base_amount") @db.Decimal(14, 2)
  withheldAmount         Decimal             @map("withheld_amount") @db.Decimal(14, 2)
  returnedBaseAmount     Decimal             @default(0) @map("returned_base_amount") @db.Decimal(14, 2)
  returnedWithheldAmount Decimal             @default(0) @map("returned_withheld_amount") @db.Decimal(14, 2)
  municipalityCode       String?             @map("municipality_code")
  chartAccountId         String              @map("chart_account_id")
  createdAt              DateTime            @default(now()) @map("created_at")

  purchase     Purchase            @relation(fields: [purchaseId], references: [id])
  concept      WithholdingConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  chartAccount ChartAccount        @relation(fields: [chartAccountId], references: [id])

  @@unique([purchaseId, conceptCode])
  @@index([purchaseId])
  @@index([conceptId])
  @@index([chartAccountId])
  @@map("purchase_retentions")
}

model PurchaseDetail {
  id                  String              @id @default(cuid())
  legacyMongoId       String?             @unique @map("legacy_mongo_id")
  purchaseId          String              @map("purchase_id")
  productId           String              @map("product_id")
  quantity            Int
  unitcost            Decimal             @db.Decimal(12, 2)
  total               Decimal             @db.Decimal(12, 2)
  // IVA descontable (input VAT credit, ET art. 485-490): same frozen-at-
  // creation pattern as OrderDetail's matching columns
  // (order.service.js#computeOrderTotals) - resolved once, at purchase
  // creation, against both the product's tax classification and the
  // company's VAT responsibility at that moment (purchase.service.js#
  // computePurchaseItemTax), so a later product/company change never
  // rewrites the tax already recorded for a purchase already made.
  // `total` above stays tax-exclusive (quantity * unitcost, unchanged) -
  // taxAmount is tracked separately, same convention as OrderDetail.
  taxTreatmentApplied ProductTaxTreatment @default(taxed) @map("tax_treatment_applied")
  taxRateApplied      Decimal             @default(0) @map("tax_rate_applied") @db.Decimal(5, 2)
  taxAmount           Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  // Running totals across every partial return event for this line, not a
  // single fixed value - mirrors Product.stock as a fast-read cache in front
  // of the StockMovement ledger (sourceType "purchase_return", sourceId =
  // this purchase's id) that is the actual append-only source of truth.
  // "Fully returned" is derived as returnedQuantity === quantity rather than
  // stored, since a line can be returned across more than one event.
  returnDate          DateTime?           @map("return_date")
  returnedQuantity    Int                 @default(0) @map("returned_quantity")
  refundAmount        Decimal             @default(0) @map("refund_amount") @db.Decimal(12, 2)
  returnedTaxAmount   Decimal             @default(0) @map("returned_tax_amount") @db.Decimal(12, 2)
  // Only set for a tracksBatches product - captured at purchase creation
  // (whether the purchase starts "pending" or "completed") since the lot
  // number is information the receiver states once, at intake, not
  // something to ask for again at the "pending" -> "completed" transition
  // that actually credits the stock. See purchase.service.js and
  // productBatch.service.js#creditBatch.
  batchNumber         String?             @map("batch_number")
  batchExpirationDate DateTime?           @map("batch_expiration_date")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_details")
}

enum QuotationStatus {
  draft // being edited, prices not yet locked in as final
  received // supplier's quoted prices confirmed - ready to compare/decide
  approved // converted into a real Purchase (terminal)
  rejected // discarded (terminal)
}

enum SalesQuotationStatus {
  draft
  sent
  viewed
  accepted
  rejected
  expired
  converted
}

enum SalesQuotationDiscountType {
  percentage
  fixed
}

// A customer-facing sales offer. This is intentionally separate from
// PurchaseQuotation: supplier quotes store buying costs and can become
// purchase orders, while sales quotes store selling prices and can later
// become customer orders.
model SalesQuotation {
  id               String                     @id @default(cuid())
  quotationNo      String                     @unique @map("quotation_no")
  publicToken      String?                    @unique @map("public_token")
  customerId       String                     @map("customer_id")
  pointOfSaleId    String                     @map("point_of_sale_id")
  status           SalesQuotationStatus       @default(draft)
  issuedAt         DateTime                   @default(now()) @map("issued_at")
  validUntil       DateTime?                  @map("valid_until")
  notes            String?
  subtotal         Decimal                    @db.Decimal(12, 2)
  discountType     SalesQuotationDiscountType @default(percentage) @map("discount_type")
  discountRate     Decimal                    @default(0) @map("discount_rate") @db.Decimal(5, 2)
  discount         Decimal                    @default(0) @db.Decimal(12, 2)
  tax              Decimal                    @default(0) @db.Decimal(12, 2)
  total            Decimal                    @db.Decimal(12, 2)
  createdById      String                     @map("created_by")
  updatedById      String?                    @map("updated_by")
  convertedOrderId String?                    @unique @map("converted_order_id")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  customer       Customer               @relation(fields: [customerId], references: [id])
  pointOfSale    PointOfSale            @relation(fields: [pointOfSaleId], references: [id])
  createdBy      User                   @relation("SalesQuotationCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?                  @relation("SalesQuotationUpdatedBy", fields: [updatedById], references: [id])
  convertedOrder Order?                 @relation(fields: [convertedOrderId], references: [id])
  details        SalesQuotationDetail[]

  @@index([customerId])
  @@index([pointOfSaleId])
  @@index([createdById])
  @@index([status])
  @@map("sales_quotations")
}

model SalesQuotationDetail {
  id           String  @id @default(cuid())
  quotationId  String  @map("quotation_id")
  productId    String  @map("product_id")
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  discountRate Decimal @default(0) @map("discount_rate") @db.Decimal(5, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  taxRate      Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount    Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(12, 2)

  quotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
  @@map("sales_quotation_details")
}

// A supplier's price offer for a hypothetical purchase - deliberately NOT a
// PurchaseStatus value. Even Purchase.pending is already a committed order
// (numbered, counted in reports, only waiting on physical delivery - see
// purchase.service.js#createPurchase's shouldAddStock check); a quotation is
// the pre-commitment step where several competing supplier offers can exist
// for the same need before one is chosen. No stock/tax/accounting side
// effects happen here - those only happen once a quotation is converted into
// a real Purchase (see purchase.service.js#createPurchase's
// source_quotation_id handling).
model PurchaseQuotation {
  id                  String          @id @default(cuid())
  quotationNo         String          @unique @map("quotation_no")
  supplierId          String          @map("supplier_id")
  // Same scoping as Purchase/Supplier - see purchase.service.js#createPurchase.
  pointOfSaleId       String          @map("point_of_sale_id")
  status              QuotationStatus @default(draft)
  // Optional - only shown as a soft warning in the UI, never blocks
  // conversion (a supplier may still honor an "expired" quote).
  validUntil          DateTime?       @map("valid_until")
  notes               String?
  // Set together with status flipping to "approved", inside the same
  // transaction that creates the resulting Purchase - see
  // purchase.service.js#createPurchase.
  convertedPurchaseId String?         @unique @map("converted_purchase_id")
  createdById         String          @map("created_by")
  updatedById         String?         @map("updated_by")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  supplier          Supplier                  @relation(fields: [supplierId], references: [id])
  pointOfSale       PointOfSale               @relation(fields: [pointOfSaleId], references: [id])
  createdBy         User                      @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?                     @relation("QuotationUpdatedBy", fields: [updatedById], references: [id])
  convertedPurchase Purchase?                 @relation(fields: [convertedPurchaseId], references: [id])
  details           PurchaseQuotationDetail[]

  @@index([createdById])
  @@index([supplierId])
  @@index([pointOfSaleId])
  @@map("purchase_quotations")
}

model PurchaseQuotationDetail {
  id          String  @id @default(cuid())
  quotationId String  @map("quotation_id")
  productId   String  @map("product_id")
  quantity    Int
  // The quoted price - no tax fields here, unlike PurchaseDetail: tax
  // treatment depends on live product/company state and is only meaningful
  // (and computed fresh) once this converts into a real Purchase.
  unitcost    Decimal @db.Decimal(12, 2)

  quotation PurchaseQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
  @@map("purchase_quotation_details")
}

model Order {
  id                   String      @id @default(cuid())
  legacyMongoId        String?     @unique @map("legacy_mongo_id")
  customerId           String      @map("customer_id")
  // Which physical location this sale happened at - see PointOfSale.
  // Every account has at least one default PointOfSale (auto-created), so
  // this is never optional at the application level - see the
  // add-point-of-sale migration for how existing rows were backfilled
  // before this column became NOT NULL.
  pointOfSaleId        String      @map("point_of_sale_id")
  orderDate            DateTime    @default(now()) @map("order_date")
  dueDate              DateTime?   @map("due_date")
  orderStatus          OrderStatus @default(pending) @map("order_status")
  totalProducts        Int         @map("total_products")
  subTotal             Decimal     @map("sub_total") @db.Decimal(12, 2)
  gst                  Decimal     @default(0) @db.Decimal(12, 2)
  total                Decimal     @db.Decimal(12, 2)
  invoiceNo            String      @unique @map("invoice_no")
  isTutorialData       Boolean     @default(false) @map("is_tutorial_data")
  // Where this order came from - "ohnix" (the POS/manual flow, the default
  // for every pre-existing row) or a connector's provider name (e.g.
  // "shopify") for an order ingested from an external channel. Free-form
  // rather than an enum so a future connector never needs a migration just
  // to identify itself here.
  channel              String      @default("ohnix")
  externalOrderId      String?     @map("external_order_id")
  externalConnectionId String?     @map("external_connection_id")
  createdById          String      @map("created_by")
  updatedById          String?     @map("updated_by")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  customer           Customer                 @relation(fields: [customerId], references: [id])
  pointOfSale        PointOfSale              @relation(fields: [pointOfSaleId], references: [id])
  createdBy          User                     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  updatedBy          User?                    @relation("OrderUpdatedBy", fields: [updatedById], references: [id])
  externalConnection IntegrationConnection?   @relation(fields: [externalConnectionId], references: [id])
  orderDetails       OrderDetail[]
  electronicInvoice  ElectronicInvoice?
  payments           OrderPayment[]
  paymentAllocations OrderPaymentAllocation[]
  salesQuotation     SalesQuotation?

  @@unique([externalConnectionId, externalOrderId])
  @@index([createdById])
  @@index([customerId])
  @@index([pointOfSaleId])
  @@index([externalConnectionId])
  @@map("orders")
}

model OrderDetail {
  id                      String              @id @default(cuid())
  legacyMongoId           String?             @unique @map("legacy_mongo_id")
  orderId                 String              @map("order_id")
  productId               String              @map("product_id")
  // Which variant of productId this line sold, if the product has variants
  // and the sale (POS or channel order) picked a specific one - null for
  // every pre-existing row and for a variant-less product. Purely
  // descriptive/traceability: order.service.js's tax/total computation
  // stays keyed off productId exactly as before, this field is never read
  // by that logic (see ProductVariant's schema comment on why variant stock
  // is a parallel bookkeeping figure, not the source of truth).
  variantId               String?             @map("variant_id")
  quantity                Int
  unitcost                Decimal             @db.Decimal(12, 2)
  total                   Decimal             @db.Decimal(12, 2)
  // Frozen at order creation (order.service.js#computeOrderTotals) - the
  // effective tax treatment/rate actually applied to this line, already
  // resolved against both the product's own classification AND the
  // company's VAT responsibility at that moment. Every later reader (DIAN
  // payload builders, VAT reports, credit notes) must read these instead of
  // re-deriving from the live Product/Company, so a tax-rate edit or a
  // change in company.vatResponsible after the sale never rewrites the tax
  // treatment of a line that was already sold under the old one.
  taxTreatmentApplied     ProductTaxTreatment @default(taxed) @map("tax_treatment_applied")
  taxRateApplied          Decimal             @default(0) @map("tax_rate_applied") @db.Decimal(5, 2)
  taxAmount               Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  // Per-unit inventory cost frozen when stock is actually deducted for the
  // sale. Pending/processing orders keep this null until completion. Every
  // later cancellation, return, credit note and profit report must reuse it
  // instead of reading the editable Product.buyingPrice.
  costBasisApplied        Decimal?            @map("cost_basis_applied") @db.Decimal(14, 4)
  // Running totals across every partial return event for this line - same
  // pattern as PurchaseDetail (see its schema comment): StockMovement
  // (sourceType "order_return", sourceId = this order's id) is the
  // append-only ledger, these are the fast-read cache. "Fully returned" is
  // derived as returnedQuantity === quantity, not stored.
  returnDate              DateTime?           @map("return_date")
  returnedQuantity        Int                 @default(0) @map("returned_quantity")
  refundAmount            Decimal             @default(0) @map("refund_amount") @db.Decimal(12, 2)
  returnedTaxAmount       Decimal             @default(0) @map("returned_tax_amount") @db.Decimal(12, 2)
  // Frozen at order creation (order.service.js#createOrder), same reasoning
  // as taxRateApplied above: the per-unit weight/volumetric weight the
  // product actually had when it was sold, in grams, so a later edit to the
  // product's own physical characteristics never rewrites what a shipping
  // payload for this already-placed order reports. Null when the product
  // wasn't physical (or had no weight recorded) at sale time.
  weightApplied           Decimal?            @map("weight_applied") @db.Decimal(10, 2)
  volumetricWeightApplied Decimal?            @map("volumetric_weight_applied") @db.Decimal(10, 2)
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_details")
}

model ElectronicInvoice {
  id                    String                  @id @default(cuid())
  orderId               String                  @unique @map("order_id")
  companyId             String                  @map("company_id")
  countryCode           String                  @map("country_code")
  provider              String
  status                ElectronicInvoiceStatus @default(draft)
  externalId            String?                 @unique @map("external_id")
  referenceCode         String                  @unique @map("reference_code")
  invoiceNumber         String?                 @map("invoice_number")
  cufe                  String?
  qrUrl                 String?                 @map("qr_url") @db.Text
  pdfUrl                String?                 @map("pdf_url") @db.Text
  xmlUrl                String?                 @map("xml_url") @db.Text
  rawRequest            Json?                   @map("raw_request")
  rawResponse           Json?                   @map("raw_response")
  fiscalSnapshot        Json?                   @map("fiscal_snapshot")
  errorMessage          String?                 @map("error_message") @db.Text
  // Which itcycle-api-dian Certificate actually signed this document -
  // captured from that create call's own response (its certificateId/
  // certificate.provider/certificate.certificateIdentifier, via that side's
  // `include: { certificate: true }`). Only populated for provider "itcycle"
  // - Factus/Alanube sign with their own infrastructure, not an Ohnix-held
  // certificate. certificateIdentifier is the provider's own reference for
  // THIS specific certificate (e.g. Viafirma's codRequest) - distinguishes
  // two certificates from the same provider (e.g. after a renewal), which
  // certificateProvider alone cannot.
  certificateId         String?                 @map("certificate_id")
  certificateProvider   String?                 @map("certificate_provider")
  certificateIdentifier String?                 @map("certificate_identifier")
  issuedAt              DateTime?               @map("issued_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  order       Order                    @relation(fields: [orderId], references: [id])
  company     Company                  @relation(fields: [companyId], references: [id])
  events      ElectronicInvoiceEvent[]
  creditNotes ElectronicCreditNote[]

  @@index([companyId, createdAt])
  @@index([countryCode, provider])
  @@map("electronic_invoices")
}

model ElectronicInvoiceEvent {
  id                  String                   @id @default(cuid())
  electronicInvoiceId String                   @map("electronic_invoice_id")
  eventType           String                   @map("event_type")
  status              ElectronicInvoiceStatus?
  payload             Json?
  createdAt           DateTime                 @default(now()) @map("created_at")

  electronicInvoice ElectronicInvoice @relation(fields: [electronicInvoiceId], references: [id], onDelete: Cascade)

  @@index([electronicInvoiceId, createdAt])
  @@map("electronic_invoice_events")
}

model ElectronicCreditNote {
  id                    String                  @id @default(cuid())
  invoiceId             String                  @map("invoice_id")
  correctionConceptCode String                  @map("correction_concept_code")
  referenceCode         String                  @unique @map("reference_code")
  status                ElectronicInvoiceStatus @default(draft)
  externalId            String?                 @unique @map("external_id")
  creditNoteNumber      String?                 @map("credit_note_number")
  cufe                  String?
  pdfUrl                String?                 @map("pdf_url") @db.Text
  xmlUrl                String?                 @map("xml_url") @db.Text
  observation           String?                 @db.Text
  rawRequest            Json?                   @map("raw_request")
  rawResponse           Json?                   @map("raw_response")
  errorMessage          String?                 @map("error_message") @db.Text
  // Same reasoning as ElectronicInvoice.certificateId/certificateProvider/certificateIdentifier.
  certificateId         String?                 @map("certificate_id")
  certificateProvider   String?                 @map("certificate_provider")
  certificateIdentifier String?                 @map("certificate_identifier")
  // The DIAN document and its local inventory/accounting effect are two
  // distinct commits. Persist the second one's state so an accepted fiscal
  // note can never fail locally with only a console log as evidence.
  localEffectStatus     String                  @default("pending") @map("local_effect_status")
  localEffectPayload    Json?                   @map("local_effect_payload")
  localEffectError      String?                 @map("local_effect_error") @db.Text
  localEffectAttempts   Int                     @default(0) @map("local_effect_attempts")
  localEffectAppliedAt  DateTime?               @map("local_effect_applied_at")
  issuedAt              DateTime?               @map("issued_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  invoice ElectronicInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId, createdAt])
  @@index([localEffectStatus, createdAt])
  @@map("electronic_credit_notes")
}

/// A Documento Soporte (DIAN type "05") self-issued for a Purchase from a
/// Supplier not obligated to invoice - the purchase-side mirror of
/// ElectronicInvoice. itcycle-api-dian only (no Factus/Alanube equivalent),
/// hence no `provider` branching like ElectronicInvoice has. No qrUrl -
/// itcycle-api-dian never populates one for any document type. Field is
/// `documentNumber`, not `invoiceNumber` - matches itcycle-api-dian's own
/// SupportDocument.documentNumber field name.
model PurchaseSupportDocument {
  id                    String                  @id @default(cuid())
  purchaseId            String                  @unique @map("purchase_id")
  companyId             String                  @map("company_id")
  countryCode           String                  @map("country_code")
  provider              String                  @default("itcycle")
  status                ElectronicInvoiceStatus @default(draft)
  externalId            String?                 @unique @map("external_id")
  referenceCode         String                  @unique @map("reference_code")
  documentNumber        String?                 @map("document_number")
  cufe                  String?
  pdfUrl                String?                 @map("pdf_url") @db.Text
  xmlUrl                String?                 @map("xml_url") @db.Text
  rawRequest            Json?                   @map("raw_request")
  rawResponse           Json?                   @map("raw_response")
  fiscalSnapshot        Json?                   @map("fiscal_snapshot")
  errorMessage          String?                 @map("error_message") @db.Text
  // Same reasoning as ElectronicInvoice.certificateId/certificateProvider/
  // certificateIdentifier - always populated here since PurchaseSupportDocument is itcycle-only.
  certificateId         String?                 @map("certificate_id")
  certificateProvider   String?                 @map("certificate_provider")
  certificateIdentifier String?                 @map("certificate_identifier")
  issuedAt              DateTime?               @map("issued_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  purchase Purchase                       @relation(fields: [purchaseId], references: [id])
  company  Company                        @relation(fields: [companyId], references: [id])
  events   PurchaseSupportDocumentEvent[]

  @@index([companyId, createdAt])
  @@map("purchase_support_documents")
}

model PurchaseSupportDocumentEvent {
  id                        String                   @id @default(cuid())
  purchaseSupportDocumentId String                   @map("purchase_support_document_id")
  eventType                 String                   @map("event_type")
  status                    ElectronicInvoiceStatus?
  payload                   Json?
  createdAt                 DateTime                 @default(now()) @map("created_at")

  purchaseSupportDocument PurchaseSupportDocument @relation(fields: [purchaseSupportDocumentId], references: [id], onDelete: Cascade)

  @@index([purchaseSupportDocumentId, createdAt])
  @@map("purchase_support_document_events")
}

/// Buyer-side acknowledgment tracking for a THIRD-PARTY supplier invoice
/// (ET art. 616-1, Ley 2155 de 2021 art. 13) - distinct from and unrelated
/// to PurchaseSupportDocument, which is for self-issued Documento Soporte.
/// Only relevant when purchase.supplier.issuesElectronicInvoice is true.
/// PHASE 1: itcycle-api-dian only accepts these events in
/// DIAN_SIMULATION_MODE - see that repo's
/// receiptAcknowledgment.service.ts#assertSimulationOnly. One row per
/// Purchase, created the first time any of the four events is triggered.
model ReceivedInvoiceReceipt {
  id          String @id @default(cuid())
  purchaseId  String @unique @map("purchase_id")
  companyId   String @map("company_id")
  countryCode String @map("country_code")
  provider    String @default("itcycle")

  // The supplier's OWN invoice being acknowledged - entered by the buyer,
  // never computed by Ohnix. supplierCufe is the primary legal reference
  // every one of the four events must carry to DIAN.
  supplierInvoiceNumber String    @map("supplier_invoice_number")
  supplierCufe          String    @map("supplier_cufe")
  supplierIssuedAt      DateTime? @map("supplier_issued_at")

  // --- Acuse de recibo (ET art. 616-1 par. 4) ---
  acuseStatus     ElectronicInvoiceStatus @default(draft) @map("acuse_status")
  acuseExternalId String?                 @map("acuse_external_id")
  acuseSentAt     DateTime?               @map("acuse_sent_at")

  // --- Recibo del bien y/o servicio (ET art. 616-1 par. 4) ---
  recepcionStatus     ElectronicInvoiceStatus @default(draft) @map("recepcion_status")
  recepcionExternalId String?                 @map("recepcion_external_id")
  recepcionSentAt     DateTime?               @map("recepcion_sent_at")

  // --- Aceptación expresa (buyer's explicit choice, mutually exclusive with reclamo) ---
  aceptacionExpresaStatus     ElectronicInvoiceStatus? @map("aceptacion_expresa_status")
  aceptacionExpresaExternalId String?                  @map("aceptacion_expresa_external_id")
  aceptacionExpresaSentAt     DateTime?                @map("aceptacion_expresa_sent_at")

  // --- Reclamo (buyer's explicit choice, mutually exclusive with aceptación expresa) ---
  reclamoStatus     ElectronicInvoiceStatus? @map("reclamo_status")
  reclamoExternalId String?                  @map("reclamo_external_id")
  reclamoSentAt     DateTime?                @map("reclamo_sent_at")
  reclamoReason     String?                  @map("reclamo_reason") @db.Text

  // --- Aceptación tácita - PURELY COMPUTED, never transmitted to DIAN ---
  // Populated only once recepcionSentAt is set: recepcionSentAt + 3
  // business days (see utils/businessDays.js + receiptTacitaScheduler.js).
  // Colombian public holidays are NOT excluded (known Phase 1 limitation,
  // informational-only impact since this is never sent to DIAN).
  tacitaDeadlineAt DateTime? @map("tacita_deadline_at")
  tacitaAppliedAt  DateTime? @map("tacita_applied_at")

  errorMessage String? @map("error_message") @db.Text

  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchase  Purchase                      @relation(fields: [purchaseId], references: [id])
  company   Company                       @relation(fields: [companyId], references: [id])
  createdBy User                          @relation(fields: [createdById], references: [id])
  events    ReceivedInvoiceReceiptEvent[]

  @@index([companyId, createdAt])
  // Drives the tácita scheduler's sweep: "recepción sent, no reclamo yet,
  // deadline in the past" without a full table scan.
  @@index([tacitaDeadlineAt])
  @@map("received_invoice_receipts")
}

model ReceivedInvoiceReceiptEvent {
  id                       String                   @id @default(cuid())
  receivedInvoiceReceiptId String                   @map("received_invoice_receipt_id")
  eventType                String                   @map("event_type")
  status                   ElectronicInvoiceStatus?
  payload                  Json?                    @map("payload")
  createdAt                DateTime                 @default(now()) @map("created_at")

  receivedInvoiceReceipt ReceivedInvoiceReceipt @relation(fields: [receivedInvoiceReceiptId], references: [id], onDelete: Cascade)

  @@index([receivedInvoiceReceiptId, createdAt])
  @@map("received_invoice_receipt_events")
}

// ─── Teams (collaborative accounts, Business plan and up) ──────────────────
//
// Ownership model: every business resource (Product, Order, Customer, ...)
// stays scoped by its existing `createdById` column, which for a team
// member's actions is set to the TEAM OWNER's user id, not the acting
// member's - see resolveRequestActor() in auth.middleware.js. This means
// every plan-limit check, uniqueness constraint and query already written
// against createdById keeps working unmodified: a team is just its owner's
// account, shared. TeamActivityLog is the audit trail for team-management
// actions specifically (invites, role changes, removals) - it does not
// track authorship of individual business records in this phase.
model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner       User              @relation("TeamOwner", fields: [ownerId], references: [id])
  roles       TeamRole[]
  members     TeamMember[]
  invitations TeamInvitation[]
  activityLog TeamActivityLog[]

  @@map("teams")
}

// Roles are per-team (not global) so each owner defines their own module
// access levels. isOwnerRole marks the single implicit "Owner" role created
// with the team - it always has admin on every module and cannot be edited
// or deleted (enforced in team.service.js, not at the DB level).
model TeamRole {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  name        String
  isOwnerRole Boolean  @default(false) @map("is_owner_role")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team        Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  permissions TeamRolePermission[]
  members     TeamMember[]
  invitations TeamInvitation[]

  @@unique([teamId, name])
  @@map("team_roles")
}

// One row per (role, module). Missing rows mean "none" - see MODULE_KEYS in
// team.permissions.js for the fixed set of valid moduleKey values.
model TeamRolePermission {
  id        String          @id @default(cuid())
  roleId    String          @map("role_id")
  moduleKey String          @map("module_key")
  level     PermissionLevel @default(none)

  role TeamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleKey])
  @@map("team_role_permissions")
}

// No DB-level unique on userId: a removed membership (status: removed) is
// kept for history, and app logic (not a constraint) enforces that a user
// has at most one ACTIVE membership at a time across all teams.
model TeamMember {
  id          String           @id @default(cuid())
  teamId      String           @map("team_id")
  userId      String           @map("user_id")
  roleId      String           @map("role_id")
  status      TeamMemberStatus @default(active)
  invitedById String?          @map("invited_by")
  joinedAt    DateTime         @default(now()) @map("joined_at")
  removedAt   DateTime?        @map("removed_at")
  // Scope is orthogonal to role (see pos.permissions.js): role answers "what
  // can this member do", scope answers "where". Defaults to true so every
  // member that existed before Points of Sale shipped keeps exactly the
  // account-wide access they already had - nobody is silently locked out by
  // this migration. Only meaningful once the account actually has more than
  // one PointOfSale; ignored entirely for the account owner, who is always
  // full-scope regardless of this field (same rule as module permissions).
  scopeAll    Boolean          @default(true) @map("scope_all")

  team         Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User                    @relation(fields: [userId], references: [id])
  role         TeamRole                @relation(fields: [roleId], references: [id])
  pointsOfSale TeamMemberPointOfSale[]

  @@index([teamId, status])
  @@index([userId])
  @@map("team_members")
}

// Only has rows when the owning TeamMember.scopeAll is false - explicit
// grant list of which PointOfSale a restricted-scope member can act on.
// Membership here is checked in pos.permissions.js#resolvePosScope,
// mirrored by auth.middleware.js into req.user.posScopeIds.
model TeamMemberPointOfSale {
  id            String   @id @default(cuid())
  teamMemberId  String   @map("team_member_id")
  pointOfSaleId String   @map("point_of_sale_id")
  createdAt     DateTime @default(now()) @map("created_at")

  teamMember  TeamMember  @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  pointOfSale PointOfSale @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, pointOfSaleId])
  @@index([pointOfSaleId])
  @@map("team_member_points_of_sale")
}

// A physical/operational location under one account. Belongs to the account
// (accountId, same tenant scope teamContext.js resolves everywhere else) -
// deliberately NOT to Team, since Team only exists for accounts that opted
// into collaboration on Negocio+ (see team.service.js#createTeam), while
// every account, including a solo Starter user, has exactly one
// PointOfSale (isDefault: true) so Order/Purchase/StockMovement always have
// somewhere to point. Escala is what allows an account to create more than
// one - enforced by PLAN_LIMITS.maxPointsOfSale (pricing.middleware.js), not
// by anything in this model itself.
//
// The model name/table stayed "PointOfSale" (renaming it would have meant
// touching every file built on top of it this session for zero functional
// gain), but it is NOT rigidly a retail counter - `locationType` is what
// keeps this a general inventory-location concept, per the 2026-08-21
// multi-location inventory spec: a warehouse or distribution center is a
// PointOfSale row with locationType != point_of_sale, and everything that
// scopes by pointOfSaleId (orders, stock, transfers, LIVE rooms) works on
// it identically. Selling FROM a warehouse isn't blocked at this layer -
// that's a product/business decision, not a schema one.
enum LocationType {
  point_of_sale
  warehouse
  distribution_center
}

model PointOfSale {
  id                  String       @id @default(cuid())
  accountId           String       @map("account_id")
  name                String
  locationType        LocationType @default(point_of_sale) @map("location_type")
  isDefault           Boolean      @default(false) @map("is_default")
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  defaultCostCenterId String?      @map("default_cost_center_id")

  account           User                    @relation("PointOfSaleAccount", fields: [accountId], references: [id])
  members           TeamMemberPointOfSale[]
  orders            Order[]
  purchases         Purchase[]
  stockMovements    StockMovement[]
  locationStock     ProductLocationStock[]
  transfersOut      StockTransfer[]         @relation("StockTransferFrom")
  transfersIn       StockTransfer[]         @relation("StockTransferTo")
  productBatches    ProductBatch[]
  productionOrders  ProductionOrder[]
  employees         Employee[]
  customers         Customer[]
  suppliers         Supplier[]
  cashAccounts      CashAccount[]
  quotations        PurchaseQuotation[]
  salesQuotations   SalesQuotation[]
  defaultCostCenter CostCenter?             @relation(fields: [defaultCostCenterId], references: [id])

  @@index([accountId, isActive])
  @@index([defaultCostCenterId])
  @@map("points_of_sale")
}

enum CashAccountType {
  cash
  bank
}

// A cash drawer (one per Point of Sale, typically) or a bank account
// (usually company-wide, so pointOfSaleId is nullable - enforced at the
// service layer, not the DB, same as several other conditional-requirement
// fields in this schema, e.g. RESTOCK_CONCEPT_CODES items).
model CashAccount {
  id             String          @id @default(cuid())
  name           String
  accountType    CashAccountType @default(cash) @map("account_type")
  pointOfSaleId  String?         @map("point_of_sale_id")
  bankName       String?         @map("bank_name")
  accountNumber  String?         @map("account_number")
  // Fast-read cache kept in sync with the CashMovement ledger the same way
  // Product.stock is a cache in front of StockMovement - always equals the
  // running sum of this account's CashMovement.delta, never written
  // directly except by cashMovement.service.js#recordCashMovement.
  balance        Decimal         @default(0) @db.Decimal(14, 2)
  isActive       Boolean         @default(true) @map("is_active")
  // Which PUC ledger account order/purchase payments through this cash
  // account post to (1105 Caja / 1110 Bancos, by default - see
  // chartOfAccounts.service.js#ensureDefaultChartOfAccounts). Nullable so
  // existing rows created before Fase 4 don't need a backfill migration -
  // resolved and persisted lazily on first payment instead (see
  // chartOfAccounts.service.js#resolveCashAccountChartAccount).
  chartAccountId String?         @map("chart_account_id")
  createdById    String          @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  pointOfSale               PointOfSale?                   @relation(fields: [pointOfSaleId], references: [id])
  chartAccount              ChartAccount?                  @relation(fields: [chartAccountId], references: [id])
  createdBy                 User                           @relation(fields: [createdById], references: [id])
  movements                 CashMovement[]
  orderPayments             OrderPayment[]
  purchasePayments          PurchasePayment[]
  paymentCredits            PaymentCreditBalance[]
  statementEntries          BankStatementEntry[]
  recurringExpenseTemplates RecurringExpenseTemplate[]     @relation("RecurringExpenseTemplateCashAccount")
  terminationSettlements    PayrollTerminationSettlement[]

  @@index([pointOfSaleId])
  @@index([createdById])
  @@map("cash_accounts")
}

enum CashMovementSourceType {
  order_payment
  purchase_payment
  customer_advance
  supplier_advance
  manual_deposit
  manual_withdrawal
  // Internal cash/bank transfers create one outgoing and one incoming
  // movement atomically; both share the transfer id as sourceId.
  transfer_out
  transfer_in
  adjustment
  payroll_payment
  payroll_benefit_settlement
  payroll_termination_settlement
}

// Append-only ledger - literal mirror of StockMovement, money instead of
// stock. Single write path: cashMovement.service.js#recordCashMovement,
// always called from inside the same transaction that changes
// CashAccount.balance so the two can never drift apart.
model CashMovement {
  id            String                 @id @default(cuid())
  cashAccountId String                 @map("cash_account_id")
  delta         Decimal                @db.Decimal(14, 2)
  balanceAfter  Decimal                @map("balance_after") @db.Decimal(14, 2)
  sourceType    CashMovementSourceType @map("source_type")
  sourceId      String?                @map("source_id")
  reason        String?                @db.Text
  // Set once a BankStatementEntry references this movement - see
  // bankReconciliation.service.js#matchEntry. Null = not reconciled yet.
  reconciledAt  DateTime?              @map("reconciled_at")
  createdById   String                 @map("created_by")
  createdAt     DateTime               @default(now()) @map("created_at")

  cashAccount    CashAccount         @relation(fields: [cashAccountId], references: [id])
  createdBy      User                @relation(fields: [createdById], references: [id])
  statementEntry BankStatementEntry?

  @@index([cashAccountId, createdAt])
  @@index([sourceType, sourceId])
  @@map("cash_movements")
}

// Cartera (accounts receivable): order.total - SUM(OrderPayment.amount) for
// that order is the pending balance - derived at read time in the cartera
// report, not stored, same principle as Product.stock being the only
// stored balance while a sale's own remaining-to-ship quantity is derived.
model OrderPayment {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  amount          Decimal  @db.Decimal(14, 2)
  cashAccountId   String   @map("cash_account_id")
  appliedCreditId String?  @map("applied_credit_id")
  // Free-text, same looseness as Supplier.type/Customer.type elsewhere in
  // this schema - "cash"/"transfer"/"card"/whatever the business uses.
  method          String?
  reference       String?
  paidAt          DateTime @default(now()) @map("paid_at")
  createdById     String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  order          Order                    @relation(fields: [orderId], references: [id])
  allocations    OrderPaymentAllocation[]
  creditBalances PaymentCreditBalance[]   @relation("OrderPaymentCreditSource")
  appliedCredit  PaymentCreditBalance?    @relation("OrderPaymentAppliedCredit", fields: [appliedCreditId], references: [id])
  cashAccount    CashAccount              @relation(fields: [cashAccountId], references: [id])
  createdBy      User                     @relation(fields: [createdById], references: [id])

  @@index([orderId])
  @@index([cashAccountId, createdAt])
  @@index([appliedCreditId])
  @@map("order_payments")
}

// Cartera (accounts payable) - mirrors OrderPayment exactly; money leaves
// cashAccount instead of entering it (see purchasePayment.service.js).
model PurchasePayment {
  id              String   @id @default(cuid())
  purchaseId      String   @map("purchase_id")
  amount          Decimal  @db.Decimal(14, 2)
  cashAccountId   String   @map("cash_account_id")
  appliedCreditId String?  @map("applied_credit_id")
  method          String?
  reference       String?
  paidAt          DateTime @default(now()) @map("paid_at")
  createdById     String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  purchase       Purchase                    @relation(fields: [purchaseId], references: [id])
  allocations    PurchasePaymentAllocation[]
  creditBalances PaymentCreditBalance[]      @relation("PurchasePaymentCreditSource")
  appliedCredit  PaymentCreditBalance?       @relation("PurchasePaymentAppliedCredit", fields: [appliedCreditId], references: [id])
  cashAccount    CashAccount                 @relation(fields: [cashAccountId], references: [id])
  createdBy      User                        @relation(fields: [createdById], references: [id])

  @@index([purchaseId])
  @@index([cashAccountId, createdAt])
  @@index([appliedCreditId])
  @@map("purchase_payments")
}

model OrderPaymentAllocation {
  id             String       @id @default(cuid())
  orderPaymentId String       @map("order_payment_id")
  orderId        String       @map("order_id")
  amount         Decimal      @db.Decimal(14, 2)
  createdById    String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  payment        OrderPayment @relation(fields: [orderPaymentId], references: [id])
  order          Order        @relation(fields: [orderId], references: [id])
  createdBy      User         @relation("OrderPaymentAllocationCreatedBy", fields: [createdById], references: [id])

  @@index([orderId])
  @@index([orderPaymentId])
  @@map("order_payment_allocations")
}

model PaymentCreditBalance {
  id                      String            @id @default(cuid())
  accountId               String            @map("account_id")
  customerId              String?           @map("customer_id")
  supplierId              String?           @map("supplier_id")
  sourceOrderPaymentId    String?           @map("source_order_payment_id")
  sourcePurchasePaymentId String?           @map("source_purchase_payment_id")
  cashAccountId           String?           @map("cash_account_id")
  amount                  Decimal           @db.Decimal(14, 2)
  appliedAmount           Decimal           @default(0) @map("applied_amount") @db.Decimal(14, 2)
  status                  String            @default("open")
  createdById             String            @map("created_by")
  createdAt               DateTime          @default(now()) @map("created_at")
  account                 User              @relation("PaymentCreditAccount", fields: [accountId], references: [id])
  customer                Customer?         @relation(fields: [customerId], references: [id])
  supplier                Supplier?         @relation(fields: [supplierId], references: [id])
  sourceOrderPayment      OrderPayment?     @relation("OrderPaymentCreditSource", fields: [sourceOrderPaymentId], references: [id])
  sourcePurchasePayment   PurchasePayment?  @relation("PurchasePaymentCreditSource", fields: [sourcePurchasePaymentId], references: [id])
  cashAccount             CashAccount?      @relation(fields: [cashAccountId], references: [id])
  appliedOrderPayments    OrderPayment[]    @relation("OrderPaymentAppliedCredit")
  appliedPurchasePayments PurchasePayment[] @relation("PurchasePaymentAppliedCredit")
  createdBy               User              @relation("PaymentCreditCreatedBy", fields: [createdById], references: [id])

  @@index([accountId, status])
  @@index([customerId, status])
  @@index([supplierId, status])
  @@map("payment_credit_balances")
}

model PurchasePaymentAllocation {
  id                String          @id @default(cuid())
  purchasePaymentId String          @map("purchase_payment_id")
  purchaseId        String          @map("purchase_id")
  amount            Decimal         @db.Decimal(14, 2)
  createdById       String          @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  payment           PurchasePayment @relation(fields: [purchasePaymentId], references: [id])
  purchase          Purchase        @relation(fields: [purchaseId], references: [id])
  createdBy         User            @relation("PurchasePaymentAllocationCreatedBy", fields: [createdById], references: [id])

  @@index([purchaseId])
  @@index([purchasePaymentId])
  @@map("purchase_payment_allocations")
}

// Bank reconciliation, deliberately simple: one row per statement line,
// entered or bulk-loaded via the API (no bank-file-format parser in this
// scope - see the fiscal audit's Fase 3 backlog). Matching an entry to an
// already-existing CashMovement is the entire reconciliation act.
model BankStatementEntry {
  id                String   @id @default(cuid())
  cashAccountId     String   @map("cash_account_id")
  entryDate         DateTime @map("entry_date")
  description       String?
  amount            Decimal  @db.Decimal(14, 2)
  matchedMovementId String?  @unique @map("matched_movement_id")
  createdById       String   @map("created_by")
  importFingerprint String?  @map("import_fingerprint")
  createdAt         DateTime @default(now()) @map("created_at")

  cashAccount     CashAccount   @relation(fields: [cashAccountId], references: [id])
  matchedMovement CashMovement? @relation(fields: [matchedMovementId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])

  @@unique([cashAccountId, importFingerprint])
  @@index([cashAccountId, entryDate])
  @@map("bank_statement_entries")
}

// Fase 4 (contabilidad automática) - Plan Único de Cuentas (PUC) colombiano,
// una fila por cuenta contable. Named ChartAccount, not Account - "account"
// already means "tenant" everywhere else in this schema (see PointOfSale's
// comment on accountId). Only ever deactivated (isActive), never deleted -
// a JournalEntryLine referencing this row must stay resolvable forever, same
// reasoning as CashAccount/PointOfSale.
enum AccountingAccountType {
  asset
  liability
  equity
  revenue
  expense
  cost
}

// Effective-dated tenant configuration. Rates are data, never hard-coded
// legislation. `ratePercent` always uses percent units: a ReteICA rate of
// 11 per thousand is stored as 1.1.
enum WithholdingTaxType {
  income
  vat
  ica
}

enum WithholdingBaseType {
  subtotal
  vat
  total
}

model ChartAccount {
  id          String                @id @default(cuid())
  code        String
  name        String
  accountType AccountingAccountType @map("account_type")
  // Self-relation for PUC's hierarchy (clase/grupo/cuenta/subcuenta) - not
  // populated by the default seed (chartOfAccounts.service.js), reserved for
  // an account added by hand later.
  parentId    String?               @map("parent_id")
  isActive    Boolean               @default(true) @map("is_active")
  createdById String                @map("created_by")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  parent                        ChartAccount?                  @relation("ChartAccountHierarchy", fields: [parentId], references: [id])
  children                      ChartAccount[]                 @relation("ChartAccountHierarchy")
  createdBy                     User                           @relation(fields: [createdById], references: [id])
  cashAccounts                  CashAccount[]
  journalEntryLines             JournalEntryLine[]
  manualVoucherLines            ManualJournalVoucherLine[]
  withholdingConcepts           WithholdingConcept[]
  purchaseRetentions            PurchaseRetention[]
  accountingBudgets             AccountingBudget[]
  recurringExpenseTemplates     RecurringExpenseTemplate[]     @relation("RecurringExpenseTemplateExpenseAccount")
  fixedAssetsAsAsset            FixedAsset[]                   @relation("FixedAssetAssetAccount")
  fixedAssetsAsDepreciation     FixedAsset[]                   @relation("FixedAssetDepreciationAccount")
  fixedAssetsAsExpense          FixedAsset[]                   @relation("FixedAssetExpenseAccount")
  recurringJournalTemplateLines RecurringJournalTemplateLine[]

  @@unique([createdById, code])
  @@index([createdById])
  @@index([parentId])
  @@map("chart_accounts")
}

model CostCenter {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account                       User                           @relation("CostCenterAccount", fields: [accountId], references: [id])
  journalEntryLines             JournalEntryLine[]
  manualVoucherLines            ManualJournalVoucherLine[]
  pointsOfSale                  PointOfSale[]
  accountingBudgets             AccountingBudget[]
  fixedAssets                   FixedAsset[]
  recurringJournalTemplateLines RecurringJournalTemplateLine[]

  @@unique([accountId, code])
  @@index([accountId, isActive])
  @@map("cost_centers")
}

model AccountingBudget {
  id                    String   @id @default(cuid())
  accountId             String   @map("account_id")
  year                  Int
  month                 Int
  chartAccountId        String   @map("chart_account_id")
  costCenterId          String?  @map("cost_center_id")
  dimensionKey          String   @map("dimension_key")
  amount                Decimal  @db.Decimal(14, 2)
  alertThresholdPercent Decimal  @default(10) @map("alert_threshold_percent") @db.Decimal(6, 2)
  createdById           String   @map("created_by")
  updatedById           String   @map("updated_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  account      User         @relation("AccountingBudgetAccount", fields: [accountId], references: [id])
  chartAccount ChartAccount @relation(fields: [chartAccountId], references: [id])
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])
  createdBy    User         @relation("AccountingBudgetCreatedBy", fields: [createdById], references: [id])
  updatedBy    User         @relation("AccountingBudgetUpdatedBy", fields: [updatedById], references: [id])

  @@unique([accountId, year, month, chartAccountId, dimensionKey])
  @@index([accountId, year, month])
  @@index([costCenterId])
  @@index([chartAccountId])
  @@map("accounting_budgets")
}

// Free-form disclosures attached to a fiscal year's financial statements
// (accounting policies, contingencies, related-party transactions, etc.) -
// purely informational, never posted or aggregated into any report the way
// AccountingBudget/ChartAccount are. `position` orders them for display;
// new notes are appended at the end (financialStatementNote.service.js
// assigns it, not a DB default, since it depends on the current count for
// that year).
model FinancialStatementNote {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  year        Int
  title       String
  content     String   @db.Text
  position    Int      @default(0)
  createdById String   @map("created_by")
  updatedById String   @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account   User @relation("FinancialStatementNoteAccount", fields: [accountId], references: [id])
  createdBy User @relation("FinancialStatementNoteCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("FinancialStatementNoteUpdatedBy", fields: [updatedById], references: [id])

  @@index([accountId, year, position])
  @@map("financial_statement_notes")
}

// A standing instruction to post the same operating expense (arriendo,
// nómina, etc.) every month, instead of the user re-entering it by hand via
// manualExpense.service.js each time. recurringExpense.service.js's daily
// cron (see recurringExpenseScheduler.js) generates one JournalEntry per
// template per calendar month once `dayOfMonth` has passed, going through
// the exact same posting path (claim cash, applyLocationCostCenter off the
// cash account's sede) as a manual expense - a template is just what decides
// WHEN and with WHAT amounts that same posting happens, never a different
// accounting treatment. No costCenterId field here on purpose: the center is
// resolved from cashAccount.pointOfSaleId at generation time, same as every
// other automated posting (accountingPosting.service.js), so moving a
// template's cash account to a different sede repoints future generations
// without editing the template itself.
model RecurringExpenseTemplate {
  id                  String              @id @default(cuid())
  createdById         String              @map("created_by")
  description         String
  expenseAccountId    String              @map("expense_account_id")
  cashAccountId       String              @map("cash_account_id")
  // The TOTAL paid each period (what actually leaves the cash/bank account),
  // not a pre-tax base - matches how a business owner actually thinks about
  // rent/a recurring bill ("I pay $1,500,000/month"), unlike a product's
  // list price. When taxTreatment is "taxed", generation backs the base and
  // taxRate-implied VAT out of this total instead of adding VAT on top of it.
  amount              Decimal             @db.Decimal(14, 2)
  taxTreatment        ProductTaxTreatment @default(excluded) @map("tax_treatment")
  taxRate             Decimal             @default(0) @map("tax_rate") @db.Decimal(5, 2)
  // 1-28 only (not 29-31) so every calendar month, February included, has an
  // unambiguous matching day - the alternative (clamping 30/31 down to each
  // month's actual last day) would silently shift a template's effective
  // date across different months.
  dayOfMonth          Int                 @default(1) @map("day_of_month")
  isActive            Boolean             @default(true) @map("is_active")
  // "YYYY-MM" of the last calendar month this template successfully posted
  // for - the cron's dedupe key, so a restart or a late run within the same
  // month never double-posts.
  lastGeneratedPeriod String?             @map("last_generated_period")
  lastRunStatus       String?             @map("last_run_status")
  lastRunError        String?             @map("last_run_error")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  createdBy      User         @relation("RecurringExpenseTemplateAccount", fields: [createdById], references: [id])
  expenseAccount ChartAccount @relation("RecurringExpenseTemplateExpenseAccount", fields: [expenseAccountId], references: [id])
  cashAccount    CashAccount  @relation("RecurringExpenseTemplateCashAccount", fields: [cashAccountId], references: [id])

  @@index([createdById, isActive])
  @@map("recurring_expense_templates")
}

// A standing multi-line manual journal entry (provisions, accrued interest,
// depreciation booked by hand for an asset class outside FixedAsset, etc.)
// that posts every month - the generic sibling of RecurringExpenseTemplate,
// which only covers the one fixed expense/cash shape. Same cron + manual
// "run now" + dedupe-by-period idiom (recurringJournal.service.js), but the
// lines themselves are exactly ManualJournalVoucherLine's shape (any
// account, either side, optional cost center/third party) and are fixed
// amounts set once at template creation - unlike a recurring expense there's
// no tax decomposition, the user already knows the peso amount to repeat.
model RecurringJournalTemplate {
  id                  String   @id @default(cuid())
  createdById         String   @map("created_by")
  description         String
  dayOfMonth          Int      @default(1) @map("day_of_month")
  isActive            Boolean  @default(true) @map("is_active")
  lastGeneratedPeriod String?  @map("last_generated_period")
  lastRunStatus       String?  @map("last_run_status")
  lastRunError        String?  @map("last_run_error")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  createdBy User                           @relation("RecurringJournalTemplateCreatedBy", fields: [createdById], references: [id])
  lines     RecurringJournalTemplateLine[]

  @@index([createdById, isActive])
  @@map("recurring_journal_templates")
}

model RecurringJournalTemplateLine {
  id                 String                    @id @default(cuid())
  templateId         String                    @map("template_id")
  chartAccountId     String                    @map("chart_account_id")
  costCenterId       String?                   @map("cost_center_id")
  debit              Decimal                   @default(0) @db.Decimal(14, 2)
  credit             Decimal                   @default(0) @db.Decimal(14, 2)
  description        String?                   @db.Text
  thirdPartyType     AccountingThirdPartyType? @map("third_party_type")
  thirdPartyId       String?                   @map("third_party_id")
  thirdPartyName     String?                   @map("third_party_name")
  thirdPartyDocument String?                   @map("third_party_document")
  position           Int

  template     RecurringJournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  chartAccount ChartAccount             @relation(fields: [chartAccountId], references: [id])
  costCenter   CostCenter?              @relation(fields: [costCenterId], references: [id])

  @@index([templateId, position])
  @@index([chartAccountId])
  @@index([costCenterId])
  @@map("recurring_journal_template_lines")
}

enum FixedAssetStatus {
  active
  // Depreciation stopped and a real disposal entry posted
  // (fixedAsset.service.js#disposeFixedAsset): removes the asset's cost and
  // its accumulated depreciation from the books, deposits any proceeds into
  // a cash account, and books the difference as a gain or loss.
  disposed
  // usefulLifeMonths reached - depreciationScheduler.js stops posting on
  // its own once monthsDepreciated hits usefulLifeMonths, no user action
  // needed to reach this state (unlike "disposed").
  fully_depreciated
}

// A registered fixed asset and its straight-line depreciation schedule.
// Structurally the non-cash sibling of RecurringExpenseTemplate (same
// monthly cron + manual "run now" + dedupe-by-period idiom - see
// fixedAssetDepreciationScheduler.js/fixedAsset.service.js#runFixedAssetDepreciationNow),
// except each posting debits an expense account and credits accumulated
// depreciation instead of crediting cash. No running "accumulated
// depreciation" balance is stored beyond `monthsDepreciated` (the dedupe/cap
// counter) - the actual peso amount is always derived from the ledger
// (depreciationAccount's balance), same "derive, don't cache" rule as every
// other balance in this schema.
model FixedAsset {
  id                    String           @id @default(cuid())
  createdById           String           @map("created_by")
  name                  String
  description           String?          @db.Text
  acquisitionDate       DateTime         @map("acquisition_date")
  acquisitionCost       Decimal          @db.Decimal(14, 2)
  salvageValue          Decimal          @default(0) @map("salvage_value") @db.Decimal(14, 2)
  usefulLifeMonths      Int              @map("useful_life_months")
  assetAccountId        String           @map("asset_account_id")
  depreciationAccountId String           @map("depreciation_account_id")
  expenseAccountId      String           @map("expense_account_id")
  costCenterId          String?          @map("cost_center_id")
  status                FixedAssetStatus @default(active)
  monthsDepreciated     Int              @default(0) @map("months_depreciated")
  // "YYYY-MM" of the last calendar month this asset successfully posted
  // depreciation for - same cron dedupe key as RecurringExpenseTemplate.
  lastDepreciatedPeriod String?          @map("last_depreciated_period")
  lastRunStatus         String?          @map("last_run_status")
  lastRunError          String?          @map("last_run_error")
  disposedAt            DateTime?        @map("disposed_at")
  disposedById          String?          @map("disposed_by")
  disposalReason        String?          @map("disposal_reason") @db.Text
  disposalAmount        Decimal?         @map("disposal_amount") @db.Decimal(14, 2)
  disposalGainLoss      Decimal?         @map("disposal_gain_loss") @db.Decimal(14, 2)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  createdBy           User         @relation("FixedAssetCreatedBy", fields: [createdById], references: [id])
  assetAccount        ChartAccount @relation("FixedAssetAssetAccount", fields: [assetAccountId], references: [id])
  depreciationAccount ChartAccount @relation("FixedAssetDepreciationAccount", fields: [depreciationAccountId], references: [id])
  expenseAccount      ChartAccount @relation("FixedAssetExpenseAccount", fields: [expenseAccountId], references: [id])
  costCenter          CostCenter?  @relation(fields: [costCenterId], references: [id])

  @@index([createdById, status])
  @@map("fixed_assets")
}

model WithholdingConcept {
  id                String              @id @default(cuid())
  accountId         String              @map("account_id")
  code              String
  name              String
  taxType           WithholdingTaxType  @map("tax_type")
  baseType          WithholdingBaseType @map("base_type")
  ratePercent       Decimal             @map("rate_percent") @db.Decimal(8, 4)
  minimumBaseAmount Decimal             @default(0) @map("minimum_base_amount") @db.Decimal(14, 2)
  effectiveFrom     DateTime            @map("effective_from")
  effectiveTo       DateTime?           @map("effective_to")
  municipalityCode  String?             @map("municipality_code")
  chartAccountId    String              @map("chart_account_id")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  chartAccount       ChartAccount        @relation(fields: [chartAccountId], references: [id])
  purchaseRetentions PurchaseRetention[]

  @@unique([accountId, code, effectiveFrom])
  @@index([accountId, isActive, effectiveFrom])
  @@index([chartAccountId])
  @@map("withholding_concepts")
}

// Renta (income tax) rates are national law, not a per-company fact - unlike
// WithholdingConcept above, this is deliberately NOT accountId-scoped: one
// row per tax year, shared by every tenant filing under Régimen Ordinario.
// Only a platform admin (isAdmin, not a company's "accounting" team
// permission) can write here - see incomeTaxConfig.service.js and
// company.routes.js's admin-only convention. isVerified defaults to false
// because these rows are seeded from Claude's best recollection of current
// law, not a DIAN resolution someone actually checked - see
// rentaDeclaration.service.js's "estimated" flag, which surfaces this same
// fact to whoever views the report.
model IncomeTaxYearConfig {
  id                  String    @id @default(cuid())
  year                Int       @unique
  ordinaryRatePercent Decimal   @map("ordinary_rate_percent") @db.Decimal(5, 2)
  uvtValue            Decimal   @map("uvt_value") @db.Decimal(12, 2)
  isVerified          Boolean   @default(false) @map("is_verified")
  verifiedAt          DateTime? @map("verified_at")
  verifiedByUserId    String?   @map("verified_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("income_tax_year_configs")
}

// Régimen Simple de Tributación tariff table (Art. 908 ET): one row per
// (year, group, tramo). minUvt/maxUvt bound the company's TOTAL annual
// gross income for that year, expressed in UVT (see IncomeTaxYearConfig.
// uvtValue for the COP conversion) - maxUvt null means "no upper bound"
// (the top bracket). Same platform-admin-only, isVerified convention as
// IncomeTaxYearConfig above.
model SimpleRegimeBracket {
  id          String            @id @default(cuid())
  year        Int
  group       SimpleRegimeGroup
  minUvt      Decimal           @map("min_uvt") @db.Decimal(10, 2)
  maxUvt      Decimal?          @map("max_uvt") @db.Decimal(10, 2)
  ratePercent Decimal           @map("rate_percent") @db.Decimal(5, 2)
  isVerified  Boolean           @default(false) @map("is_verified")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([year, group, minUvt])
  @@index([year, group])
  @@map("simple_regime_brackets")
}

enum AccountingPeriodStatus {
  open
  closed
}

// One row per (tenant, calendar month), created lazily the first time a
// journal entry needs to post into it (journalEntry.service.js#getOrCreateAccountingPeriod)
// - same "created on first use" idiom as PointOfSale's default location.
// Closing a period blocks new entries dated into it - see
// accountingPeriod.service.js#closeAccountingPeriod for why only past
// months (never the current one) can be closed.
model AccountingPeriod {
  id            String                 @id @default(cuid())
  createdById   String                 @map("created_by")
  year          Int
  month         Int
  status        AccountingPeriodStatus @default(open)
  closedAt      DateTime?              @map("closed_at")
  closedById    String?                @map("closed_by")
  reopenedUntil DateTime?              @map("reopened_until")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  createdBy      User                        @relation("AccountingPeriodCreatedBy", fields: [createdById], references: [id])
  closedBy       User?                       @relation("AccountingPeriodClosedBy", fields: [closedById], references: [id])
  journalEntries JournalEntry[]
  reopenings     AccountingPeriodReopening[]

  @@unique([createdById, year, month])
  @@index([createdById, status])
  @@map("accounting_periods")
}

model AccountingPeriodReopening {
  id           String    @id @default(cuid())
  periodId     String    @map("period_id")
  reason       String    @db.Text
  reopenedById String    @map("reopened_by")
  reopenedAt   DateTime  @default(now()) @map("reopened_at")
  expiresAt    DateTime  @map("expires_at")
  reclosedById String?   @map("reclosed_by")
  reclosedAt   DateTime? @map("reclosed_at")

  period AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, reopenedAt])
  @@map("accounting_period_reopenings")
}

enum JournalSourceType {
  order_sale
  purchase
  order_payment
  purchase_payment
  customer_advance
  supplier_advance
  payment_credit_application
  // Fase 4b (reversas) - same granularity as StockMovementSourceType's
  // matching values for these exact same events, rather than one generic
  // "reversal" value, so the ledger records why each reversal happened.
  order_cancellation
  order_return
  purchase_return
  credit_note_restock
  // Fase 4d - discount/price_adjustment/other credit notes: no stock/
  // OrderDetail effect (the customer keeps the goods), a purely financial
  // Clientes/Ingresos/IVA generado adjustment - see
  // postFinancialCreditNoteJournalEntry.
  credit_note_financial
  // Fase 5 - period close: reverses that period's revenue/cost/expense
  // activity into a retained-earnings equity account. Excluded from
  // financialStatements.service.js's income-statement aggregation (so a
  // closed period's own P&L still reads correctly) but included normally
  // in the balance sheet's equity aggregation - see closeAccountingPeriod.
  period_close
  period_reopen
  period_reclose
  // Fase 6 - fiscal year close: sweeps the "Utilidad del ejercicio" balance
  // (chartOfAccounts.service.js's CURRENT_YEAR_EARNINGS_ACCOUNT, 3610) that
  // year's 12 monthly period_close entries accumulated into "Utilidades
  // acumuladas" (RETAINED_EARNINGS_ACCOUNT, 3605) - see
  // fiscalYear.service.js#closeFiscalYear. Distinct from period_close: this
  // never touches revenue/cost/expense accounts directly, only the two
  // equity accounts. year_reopen/year_reclose mirror period_reopen/
  // period_reclose exactly, same reason: a fresh sourceId per reopen event
  // (FiscalYearReopening.id) is what lets recordJournalEntry's idempotency
  // dedup tell a year's first close apart from its second, third, etc.
  year_close
  year_reopen
  year_reclose
  inventory_adjustment
  transfer_discrepancy
  manual_journal
  manual_journal_reversal
  manual_expense
  manual_income
  cash_transfer
  cash_adjustment
  recurring_expense
  // Fase 8 - RecurringJournalTemplate's monthly posting (see model above) -
  // a generic multi-line recurring entry, unlike recurring_expense's fixed
  // expense/cash shape.
  recurring_journal
  opening_balance
  // Fase 7 - fixed assets (see FixedAsset above). fixed_asset_disposal books
  // a "baja de activo": removes the asset's cost and accumulated
  // depreciation, deposits any sale proceeds, and posts the gain/loss vs.
  // net book value - see fixedAsset.service.js#disposeFixedAsset.
  fixed_asset_depreciation
  fixed_asset_disposal
  // Fase 9 - manufacturing (see ProductionOrder above). Only posted when a
  // completed order actually applied labor/overhead cost - a materials-only
  // run nets to zero within the single Inventarios account and has nothing
  // to journal (see accountingPosting.service.js#postProductionJournalEntry).
  production
  production_reversal
  // Fase 10 - nómina (see PayrollPeriod/PayrollDocument above). `payroll` is
  // posted once a period is approved (gross expense + every liability it
  // creates); `payroll_payment` when net pay + that period's aportes are
  // actually paid out; `payroll_benefit_settlement` when an accrued
  // prestación social (cesantías/prima/...) is paid out later, on its own
  // legal calendar - see accountingPosting.service.js.
  payroll
  payroll_payment
  payroll_benefit_settlement
  // Fase 3 (liquidación) - the one consolidated entry a "Liquidar contrato"
  // action posts: drains every pending prestación-social liability at once
  // (same accounts payroll_benefit_settlement would touch one at a time)
  // plus, when applicable, the indemnización expense - see
  // accountingPosting.service.js#postTerminationSettlementJournalEntry.
  payroll_termination_settlement
}

enum FiscalYearClosureStatus {
  closed
  reopened
}

// One row per (tenant, calendar year) once that year has been closed - only
// created by fiscalYear.service.js#closeFiscalYear, which requires all 12
// AccountingPeriod rows for that year that ever had activity to already be
// `closed` (a month with no activity never gets an AccountingPeriod row at
// all, so it can't block the year). `status` is a fast flag mirroring
// AccountingPeriod.status; `reopenings` is the event log that makes a
// close -> reopen -> reclose cycle possible, same split as
// AccountingPeriod/AccountingPeriodReopening.
model FiscalYearClosure {
  id            String                  @id @default(cuid())
  createdById   String                  @map("created_by")
  year          Int
  status        FiscalYearClosureStatus @default(closed)
  closedById    String                  @map("closed_by")
  closedAt      DateTime                @default(now()) @map("closed_at")
  reopenedUntil DateTime?               @map("reopened_until")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  createdBy  User                  @relation("FiscalYearClosureCreatedBy", fields: [createdById], references: [id])
  closedBy   User                  @relation("FiscalYearClosureClosedBy", fields: [closedById], references: [id])
  reopenings FiscalYearReopening[]

  @@unique([createdById, year])
  @@index([createdById, status])
  @@map("fiscal_year_closures")
}

// Mirrors AccountingPeriodReopening exactly (same field shape, same lack of
// a User relation on reopenedById/reclosedById - plain tenant-scoped id
// columns, not FK-constrained, same as that model).
model FiscalYearReopening {
  id           String    @id @default(cuid())
  closureId    String    @map("closure_id")
  reason       String    @db.Text
  reopenedById String    @map("reopened_by")
  reopenedAt   DateTime  @default(now()) @map("reopened_at")
  expiresAt    DateTime  @map("expires_at")
  reclosedById String?   @map("reclosed_by")
  reclosedAt   DateTime? @map("reclosed_at")

  closure FiscalYearClosure @relation(fields: [closureId], references: [id])

  @@index([closureId, reopenedAt])
  @@map("fiscal_year_reopenings")
}

model AccountingConfigAudit {
  id         String   @id @default(cuid())
  accountId  String   @map("account_id")
  actorId    String   @map("actor_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  account User @relation("AccountingConfigAuditAccount", fields: [accountId], references: [id])
  actor   User @relation("AccountingConfigAuditActor", fields: [actorId], references: [id])

  @@index([accountId, entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("accounting_config_audits")
}

enum ManualVoucherStatus {
  draft
  posted
  voided
}

model ManualJournalVoucher {
  id              String              @id @default(cuid())
  accountId       String              @map("account_id")
  status          ManualVoucherStatus @default(draft)
  entryDate       DateTime            @map("entry_date")
  description     String              @db.Text
  supportUrl      String?             @map("support_url") @db.Text
  postedEntryId   String?             @unique @map("posted_entry_id")
  reversalEntryId String?             @unique @map("reversal_entry_id")
  createdById     String              @map("created_by")
  postedById      String?             @map("posted_by")
  postedAt        DateTime?           @map("posted_at")
  voidedById      String?             @map("voided_by")
  voidedAt        DateTime?           @map("voided_at")
  voidReason      String?             @map("void_reason") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  lines ManualJournalVoucherLine[]

  @@index([accountId, status, entryDate])
  @@map("manual_journal_vouchers")
}

model ManualJournalVoucherLine {
  id                 String                    @id @default(cuid())
  voucherId          String                    @map("voucher_id")
  chartAccountId     String                    @map("chart_account_id")
  costCenterId       String?                   @map("cost_center_id")
  debit              Decimal                   @default(0) @db.Decimal(14, 2)
  credit             Decimal                   @default(0) @db.Decimal(14, 2)
  description        String?                   @db.Text
  thirdPartyType     AccountingThirdPartyType? @map("third_party_type")
  thirdPartyId       String?                   @map("third_party_id")
  thirdPartyName     String?                   @map("third_party_name")
  thirdPartyDocument String?                   @map("third_party_document")
  position           Int

  voucher      ManualJournalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  chartAccount ChartAccount         @relation(fields: [chartAccountId], references: [id])
  costCenter   CostCenter?          @relation(fields: [costCenterId], references: [id])

  @@index([voucherId, position])
  @@index([chartAccountId])
  @@index([costCenterId])
  @@index([thirdPartyType, thirdPartyId])
  @@map("manual_journal_voucher_lines")
}

// Append-only double-entry ledger header - mirrors StockMovement/CashMovement's
// "single write path" idiom (journalEntry.service.js#recordJournalEntry), but
// with N lines per entry instead of one delta, since a journal entry only
// means something as a balanced set (debits === credits, enforced at the
// service layer - see recordJournalEntry). Tenant scope is inherited via
// periodId -> AccountingPeriod.createdById (like CashMovement inherits via
// cashAccountId), not a redundant column here.
model JournalEntry {
  id          String            @id @default(cuid())
  periodId    String            @map("period_id")
  entryDate   DateTime          @map("entry_date")
  description String?           @db.Text
  sourceType  JournalSourceType @map("source_type")
  sourceId    String?           @map("source_id")
  createdById String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  period    AccountingPeriod   @relation(fields: [periodId], references: [id])
  createdBy User               @relation(fields: [createdById], references: [id])
  lines     JournalEntryLine[]

  @@index([periodId])
  @@index([sourceType, sourceId])
  @@index([entryDate])
  @@map("journal_entries")
}

// One debit or credit line of a JournalEntry - never both (enforced by a
// hand-added CHECK constraint in this model's migration, see
// migration.sql). No running balance field here on purpose (unlike
// CashAccount.balance/Product.stock) - nothing needs a fast-read per-account
// balance yet since there are no financial statements until Fase 5; a
// balance is derived at report time by summing debit - credit per
// chartAccountId.
model JournalEntryLine {
  id                 String                    @id @default(cuid())
  journalEntryId     String                    @map("journal_entry_id")
  chartAccountId     String                    @map("chart_account_id")
  costCenterId       String?                   @map("cost_center_id")
  debit              Decimal                   @default(0) @db.Decimal(14, 2)
  credit             Decimal                   @default(0) @db.Decimal(14, 2)
  description        String?                   @db.Text
  thirdPartyType     AccountingThirdPartyType? @map("third_party_type")
  thirdPartyId       String?                   @map("third_party_id")
  thirdPartyName     String?                   @map("third_party_name")
  thirdPartyDocument String?                   @map("third_party_document")
  createdAt          DateTime                  @default(now()) @map("created_at")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  chartAccount ChartAccount @relation(fields: [chartAccountId], references: [id])
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])

  @@index([journalEntryId])
  @@index([chartAccountId])
  @@index([costCenterId])
  @@index([thirdPartyType, thirdPartyId])
  @@map("journal_entry_lines")
}

enum AccountingThirdPartyType {
  customer
  supplier
  other
}

model TeamInvitation {
  id          String               @id @default(cuid())
  teamId      String               @map("team_id")
  email       String
  token       String               @unique
  roleId      String               @map("role_id")
  status      TeamInvitationStatus @default(pending)
  invitedById String               @map("invited_by")
  expiresAt   DateTime             @map("expires_at")
  acceptedAt  DateTime?            @map("accepted_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole @relation(fields: [roleId], references: [id])
  invitedBy User     @relation("InvitationsSent", fields: [invitedById], references: [id])

  @@index([teamId, status])
  @@index([email])
  @@map("team_invitations")
}

model TeamActivityLog {
  id           String   @id @default(cuid())
  teamId       String   @map("team_id")
  actorId      String?  @map("actor_id")
  action       String
  targetUserId String?  @map("target_user_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@map("team_activity_logs")
}

// Backs Backend/middleware/idempotency.middleware.js: lets a client-supplied
// `Idempotency-Key` header make a retried mutation (network timeout, a
// double-click that slips in before the button disables, an automatic axios
// retry) replay the first response instead of re-running the operation a
// second time. The `[accountId, scope, key]` unique constraint is what
// actually enforces "only one attempt wins" - two concurrent requests with
// the same key race on the INSERT, and the loser reads back the winner's
// row instead of proceeding. No automatic cleanup exists yet; this table
// grows unboundedly until a pruning job is added.
model IdempotencyKey {
  id             String   @id @default(cuid())
  accountId      String   @map("account_id")
  scope          String
  key            String
  status         String   @default("processing")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([accountId, scope, key])
  @@map("idempotency_keys")
}

// One connected external e-commerce channel/system for an account - the
// core row of the connector architecture (see connectors/base.connector.js).
// `config` holds non-secret provider settings (shop domain, which
// PointOfSale to sync stock against, which events to push); the actual
// secret (access token, webhook signing secret) lives encrypted in
// credentialsEncrypted (see utils/crypto.js) and is never returned by any
// API response - same "shown once, then only a masked hint" posture as
// ApiKey.
model IntegrationConnection {
  id                   String              @id @default(cuid())
  accountId            String              @map("account_id")
  provider             IntegrationProvider
  name                 String
  status               IntegrationStatus   @default(disconnected)
  config               Json                @default("{}")
  credentialsEncrypted String?             @map("credentials_encrypted") @db.Text
  lastSyncedAt         DateTime?           @map("last_synced_at")
  lastError            String?             @map("last_error") @db.Text
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  account            User                @relation(fields: [accountId], references: [id])
  externalReferences ExternalReference[]
  syncLogs           SyncLog[]
  orders             Order[]

  @@index([accountId])
  @@map("integration_connections")
}

// Generic Ohnix-entity <-> external-channel-id mapping - see the
// e-commerce integration design's "never depend on SKU/name alone" rule.
// entityType+entityId identify the Ohnix row (Product/ProductVariant/
// Order/Customer) without a typed FK per entity, so adding a new syncable
// entity type never requires a schema change here.
model ExternalReference {
  id           String             @id @default(cuid())
  connectionId String             @map("connection_id")
  entityType   ExternalEntityType @map("entity_type")
  entityId     String             @map("entity_id")
  externalId   String             @map("external_id")
  externalUrl  String?            @map("external_url") @db.Text
  // Connector-specific auxiliary ids that don't deserve their own column
  // (e.g. Shopify's inventory_item_id, needed alongside the variant's own
  // product/variant id to push inventory levels).
  metadata     Json?
  lastSyncedAt DateTime?          @map("last_synced_at")
  lastError    String?            @map("last_error") @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, entityType, entityId])
  @@unique([connectionId, entityType, externalId])
  @@index([connectionId])
  @@map("external_references")
}

// Audit trail for every push/pull a connector performs - what the admin
// monitoring panel reads (see the e-commerce integration design's
// "Panel de monitoreo" section). One row per attempt, success or failure.
model SyncLog {
  id              String           @id @default(cuid())
  connectionId    String           @map("connection_id")
  direction       SyncLogDirection
  entityType      String           @map("entity_type")
  action          String
  entityId        String?          @map("entity_id")
  externalId      String?          @map("external_id")
  status          SyncLogStatus
  requestPayload  Json?            @map("request_payload")
  responsePayload Json?            @map("response_payload")
  errorMessage    String?          @map("error_message") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@map("sync_logs")
}

// An external system's subscription to Ohnix's own outbound webhooks (a
// custom-API integration registering "notify me at this URL for these
// events") - distinct from IntegrationConnection, which is Ohnix calling
// OUT to a channel's own API. `secret` signs every delivery (see
// utils/webhookSigning.js) so the receiver can verify a payload really
// came from Ohnix.
model WebhookEndpoint {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  url       String   @db.Text
  secret    String
  events    String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account    User              @relation(fields: [accountId], references: [id])
  deliveries WebhookDelivery[]

  @@index([accountId])
  @@map("webhook_endpoints")
}

// One delivery attempt (and its retries) of one event to one
// WebhookEndpoint. eventId is the idempotency key on the RECEIVING end
// (sent as a header so the external system can dedupe a retried delivery);
// (endpointId, eventId) is also unique here so Ohnix itself never enqueues
// the same event twice for the same endpoint.
model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String                @map("endpoint_id")
  eventType      String                @map("event_type")
  eventId        String                @map("event_id")
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  responseStatus Int?                  @map("response_status")
  lastError      String?               @map("last_error") @db.Text
  nextAttemptAt  DateTime?             @map("next_attempt_at")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

// Tracks which FirmaPass validations (auto-attached to iTCycle's alliance
// account the moment a client buys a certificate with the coupon - see
// Backend/services/firmaPassProvisioning.service.js) an admin has already
// been alerted about, so firmaPassValidationScheduler.js's periodic check
// never emails the same one twice. Not tied to any Ohnix Company - a
// validation only gets matched to one once an admin recognizes it by its
// `nombre` label (FirmaPass exposes no email or other identifying field).
model FirmaPassValidationAlert {
  id             String   @id @default(cuid())
  validationUuid String   @unique @map("validation_uuid")
  nombre         String?
  estado         String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("firmapass_validation_alerts")
}

enum DianTestMatrixRunStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum DianTestMatrixDocumentType {
  invoice
  creditNote
  debitNote
}

enum DianTestMatrixDocumentStatus {
  pending
  sending
  sent
  accepted
  rejected
  error
}

/// One admin-triggered run of the DIAN habilitación "set de pruebas" for one
/// company already provisioned with itcycle-api-dian (software propio - see
/// ElectronicInvoicingSettings.jsx's software step). `testSetId` is captured
/// per-run rather than on Company since it's only relevant transiently
/// during habilitación and never reused once the company moves to
/// PRODUCTION. See Backend/services/dianTestMatrix.service.js for the
/// orchestration this drives.
model DianTestMatrixRun {
  id                String                  @id @default(cuid())
  companyId         String                  @map("company_id")
  testSetId         String                  @map("test_set_id")
  status            DianTestMatrixRunStatus @default(pending)
  invoiceTarget     Int                     @default(30) @map("invoice_target")
  creditNoteTarget  Int                     @default(10) @map("credit_note_target")
  debitNoteTarget   Int                     @default(10) @map("debit_note_target")
  passResult        Boolean?                @map("pass_result")
  // Checked by the worker between documents (never mid-flight on one) so an
  // admin can stop a run started against the wrong company/testSetId
  // without waiting out the full 50-document poll budget.
  cancelRequested   Boolean                 @default(false) @map("cancel_requested")
  errorMessage      String?                 @map("error_message") @db.Text
  requestedByUserId String                  @map("requested_by_user_id")
  startedAt         DateTime?               @map("started_at")
  finishedAt        DateTime?               @map("finished_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  company     Company                  @relation(fields: [companyId], references: [id])
  requestedBy User                     @relation(fields: [requestedByUserId], references: [id])
  documents   DianTestMatrixDocument[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@map("dian_test_matrix_runs")
}

/// One synthetic document (factura/nota crédito/nota débito) submitted as
/// part of a DianTestMatrixRun. `referenceInvoiceSequence` links a note back
/// to the invoice (by its `sequence` within the same run) it corrects - notes
/// reuse any already-ACCEPTED invoice from the run, not necessarily distinct
/// ones. `externalId` is itcycle-api-dian's own Invoice/CreditNote/DebitNote
/// id, needed to call refreshItcycleDocumentStatus.
model DianTestMatrixDocument {
  id                       String                       @id @default(cuid())
  runId                    String                       @map("run_id")
  sequence                 Int
  documentType             DianTestMatrixDocumentType   @map("document_type")
  referenceInvoiceSequence Int?                         @map("reference_invoice_sequence")
  internalReference        String                       @unique @map("internal_reference")
  externalId               String?                      @map("external_id")
  // Which itcycle-api-dian Certificate actually signed this test document -
  // captured from that create call's own response (its certificateId/
  // certificate.provider/certificate.certificateIdentifier, via `include: {
  // certificate: true }`), not looked up separately, since a company can
  // have certificates from more than one provider active at once (see
  // certificateProviderOverride). certificateIdentifier is the provider's
  // own reference for THIS specific certificate (e.g. Viafirma's
  // codRequest) - distinguishes two certificates from the same provider
  // (e.g. after a renewal), which certificateProvider alone cannot.
  certificateId            String?                      @map("certificate_id")
  certificateProvider      String?                      @map("certificate_provider")
  certificateIdentifier    String?                      @map("certificate_identifier")
  status                   DianTestMatrixDocumentStatus @default(pending)
  cufe                     String?
  statusDescription        String?                      @map("status_description") @db.Text
  errorMessage             String?                      @map("error_message") @db.Text
  attempts                 Int                          @default(0)
  sentAt                   DateTime?                    @map("sent_at")
  resolvedAt               DateTime?                    @map("resolved_at")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")

  run DianTestMatrixRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, status])
  @@index([runId, documentType])
  @@map("dian_test_matrix_documents")
}

// In-app help assistant (Ohnix Asistente) - read-only, documentation-grounded.
// See services/assistant.service.js for the retrieval + guardrail logic that
// keeps answers scoped to AssistantKnowledgeChunk content instead of letting
// the model free-generate on DIAN/tax/accounting topics.
model AssistantKnowledgeChunk {
  id          String   @id @default(cuid())
  // Matches middleware/team.permissions.js MODULE_KEYS where applicable, plus
  // "general" for cross-module/onboarding content not tied to one screen.
  module      String
  locale      String   @default("es")
  title       String
  body        String   @db.Text
  tags        String[] @default([])
  // guide | faq | concept | dian - purely informational, no behavior differs
  // by type today; kept so the KB can be filtered/reported on later.
  sourceType  String   @default("guide") @map("source_type")
  // Starts false on every seeded entry - a human must review and flip this
  // before the assistant can ever cite it, since this is the only thing
  // standing between "the model answers from curated Ohnix content" and
  // "the model improvises," especially for DIAN/impuestos/contabilidad.
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([module, locale, title])
  @@index([module, locale, isPublished])
  @@map("assistant_knowledge_chunks")
}

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // First user message, truncated - shown in a future history list. Not
  // required for Fase 1's single-thread widget but costs nothing to store.
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String          @map("conversation_id")
  role           ChatMessageRole
  content        String          @db.Text
  // Route/module the user was on when this message was sent - context only,
  // never used to grant access to anything.
  module         String?
  // Knowledge chunk ids/titles the assistant grounded this reply on, so the
  // frontend can show "fuentes" links. Null for user messages and for the
  // fixed no-match fallback (nothing was actually retrieved).
  sources        Json?
  createdAt      DateTime        @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     ChatFeedback?

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

enum ChatMessageRole {
  user
  assistant
}

model ChatFeedback {
  id        String             @id @default(cuid())
  messageId String             @unique @map("message_id")
  rating    ChatFeedbackRating
  comment   String?
  createdAt DateTime           @default(now()) @map("created_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("chat_feedback")
}

enum ChatFeedbackRating {
  up
  down
}

// ---------------------------------------------------------------------------
// Discovery Engine (Fase 1 - base): Ohnix noticing things nobody asked about,
// not another report/KPI screen. See docs/discovery-engine.md for the full
// design. Detectors never write prose with invented numbers - everything a
// Discovery says must trace back to a DiscoveryEvidence row.
// ---------------------------------------------------------------------------

enum DiscoveryType {
  risk
  opportunity
  contradiction
  new_pattern
  connection
  trajectory_shift
  perception_gap
}

// detected: a detector produced a candidate. investigating: gathering more
// evidence before it's shown to anyone. validated: evidence crossed the
// detector's confidence bar. published: shown to the user ("Ohnix encontró
// algo"). actioned: user did something about it. resolved: the underlying
// situation is over (churned, fixed, expired). dismissed: user said "not
// relevant" - stays for learning, just stops surfacing. learned: any
// attached DiscoveryPrediction has been checked against reality and fed back
// into DiscoveryPatternStats.
enum DiscoveryStatus {
  detected
  investigating
  validated
  published
  actioned
  resolved
  dismissed
  learned
}

// One finding. dedupeKey scopes "is this the same thing we already raised" -
// discoveryEngine.service.js only opens a new row when no non-resolved
// Discovery shares (accountId, dedupeKey); a re-detection instead bumps
// lastSeenAt on the existing row. Score fields are each 0-1, combined into
// priorityScore by discoveryScoring.js so ranking logic lives in one place
// instead of being re-derived ad hoc wherever discoveries are listed.
model Discovery {
  id                 String          @id @default(cuid())
  accountId          String          @map("account_id")
  detectorKey        String          @map("detector_key")
  type               DiscoveryType
  status             DiscoveryStatus @default(detected)
  dedupeKey          String          @map("dedupe_key")
  title              String
  summary            String          @db.Text
  hypothesis         String?         @db.Text
  unknowns           String?         @db.Text
  recommendation     String?         @db.Text
  confidence         Decimal         @db.Decimal(4, 3)
  impactScore        Decimal         @map("impact_score") @db.Decimal(4, 3)
  noveltyScore       Decimal         @map("novelty_score") @db.Decimal(4, 3)
  urgencyScore       Decimal         @map("urgency_score") @db.Decimal(4, 3)
  reversibility      Decimal         @db.Decimal(4, 3)
  priorityScore      Decimal         @map("priority_score") @db.Decimal(6, 3)
  entityCount        Int             @default(0) @map("entity_count")
  // When the underlying pattern is believed to have started, per the
  // detector's own evidence (e.g. earliest order in a decaying-frequency
  // cohort) - distinct from firstDetectedAt, which is just when Ohnix
  // noticed it.
  patternSince       DateTime?       @map("pattern_since")
  firstDetectedAt    DateTime        @default(now()) @map("first_detected_at")
  lastSeenAt         DateTime        @default(now()) @map("last_seen_at")
  publishedAt        DateTime?       @map("published_at")
  resolvedAt         DateTime?       @map("resolved_at")
  // Mission case G ("errores de percepción"): the human's own stated reason
  // for dismissing this finding - "lo que el equipo cree" is captured here
  // rather than through any new belief-tracking UI. upsertDiscovery reads
  // this back the next time the same dedupeKey fires again: a pattern that
  // recurs after being dismissed with a reason is real, evidence-based
  // grounds to gently surface "dijiste X, y volvió a pasar" - never framed
  // as the user being wrong, just as a fact worth re-checking.
  dismissReason      String?         @map("dismiss_reason") @db.Text
  dismissedAt        DateTime?       @map("dismissed_at")
  // Case G, generalized beyond dismissal: a belief the user can attach to
  // ANY discovery at ANY time, not just when closing it - "¿qué crees que
  // está pasando?". `teamExplanationTag` is a small closed set of
  // structured, checkable claims (see EXPLANATION_TAGS in
  // discoveryExplanation.service.js) rather than free-form NLP - a tagged
  // explanation can get a real evidence-backed check (see
  // DiscoveryEvidence kind "explanation_check"); an untagged one just gets
  // stored for the perception-gap recurrence check upsertDiscovery already
  // does for dismissals.
  teamExplanation    String?         @map("team_explanation") @db.Text
  teamExplanationTag String?         @map("team_explanation_tag")
  teamExplanationAt  DateTime?       @map("team_explanation_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  account     User                  @relation(fields: [accountId], references: [id])
  evidence    DiscoveryEvidence[]
  entities    DiscoveryEntityLink[]
  predictions DiscoveryPrediction[]

  @@index([accountId, status, priorityScore])
  @@index([accountId, dedupeKey, status])
  @@index([detectorKey])
  @@map("discoveries")
}

// Structured, numeric evidence backing a Discovery - the "how do I know
// this" trail from section 12 of the mission. kind namespaces what's inside
// `data` (e.g. "metric_series", "comparison", "cohort_sample") so the
// frontend can render each shape without guessing; sourceType/sourceId point
// back at the originating row (StockMovement, CashMovement, Order...) the
// same way CashMovement/JournalEntry already reference their own sources.
model DiscoveryEvidence {
  id          String   @id @default(cuid())
  discoveryId String   @map("discovery_id")
  kind        String
  label       String
  data        Json
  sourceType  String?  @map("source_type")
  sourceId    String?  @map("source_id")
  createdAt   DateTime @default(now()) @map("created_at")

  discovery Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@index([discoveryId])
  @@map("discovery_evidence")
}

// Which real business entities a Discovery is about (17 customers, a
// supplier, a cash account...), so the UI can deep-link to the affected
// records instead of only showing a count. entityType is a free string
// (customer/product/supplier/cash_account/...) on purpose, same convention
// as AccountingConfigAudit.entityType - discovery types will keep needing
// new entity kinds and an enum would need a migration every time.
model DiscoveryEntityLink {
  id          String   @id @default(cuid())
  discoveryId String   @map("discovery_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  role        String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  discovery Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@index([discoveryId])
  @@index([entityType, entityId])
  @@map("discovery_entity_links")
}

enum DiscoveryPredictionOutcome {
  correct
  incorrect
  inconclusive
}

// Fase 4 learning loop (mission section 9/10): a Discovery can register a
// falsifiable prediction ("if this continues, X will happen by checkAfter").
// discoveryLearning.service.js re-checks it against real data once
// checkAfter passes, records actualData/outcome, and rolls the result into
// DiscoveryPatternStats for that detectorKey.
model DiscoveryPrediction {
  id                String                      @id @default(cuid())
  discoveryId       String                      @map("discovery_id")
  statement         String                      @db.Text
  predictedData     Json                        @map("predicted_data")
  confidenceAtStake Decimal                     @map("confidence_at_stake") @db.Decimal(4, 3)
  checkAfter        DateTime                    @map("check_after")
  checkedAt         DateTime?                   @map("checked_at")
  actualData        Json?                       @map("actual_data")
  outcome           DiscoveryPredictionOutcome?
  notes             String?                     @db.Text
  createdAt         DateTime                    @default(now()) @map("created_at")

  discovery Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@index([discoveryId])
  @@index([checkAfter, checkedAt])
  @@map("discovery_predictions")
}

// Running accuracy per detector, not per account - the point is
// cross-account learning ("this pattern type has historically been right
// 68% of the time"), fed back into new Discovery.confidence for the same
// detectorKey. Only written by discoveryLearning.service.js when a
// DiscoveryPrediction gets checked.
model DiscoveryPatternStats {
  id                 String   @id @default(cuid())
  detectorKey        String   @unique @map("detector_key")
  totalPredictions   Int      @default(0) @map("total_predictions")
  correctPredictions Int      @default(0) @map("correct_predictions")
  currentConfidence  Decimal  @default(0.5) @map("current_confidence") @db.Decimal(4, 3)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("discovery_pattern_stats")
}

// The one piece of infrastructure this schema never had: metrics over time.
// Every other report (report.controller.js) computes on demand and throws
// the result away, so there was nothing to compare "now" against "history"
// without rescanning full ledgers on every detector run. metricSnapshot
// .service.js upserts one row per (account, entityType, entityId, metricKey,
// periodStart); entityId is "" (not null - Postgres treats NULLs as
// distinct in a unique index, which would silently defeat this constraint)
// for account-level metrics that aren't about one entity.
model MetricSnapshot {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  metricKey   String   @map("metric_key")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  value       Decimal  @db.Decimal(18, 4)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  account User @relation(fields: [accountId], references: [id])

  @@unique([accountId, entityType, entityId, metricKey, periodStart])
  @@index([accountId, metricKey, periodStart])
  @@map("metric_snapshots")
}

// ============================================================================
// Nómina Electrónica - Fases 1-6 (empleados, parámetros legales, motor de
// cálculo, ciclo de vida del período + contabilización, prestaciones
// sociales). El envío del documento a la DIAN (CUNE, XML UBL de nómina,
// habilitación) es una fase posterior y separada - ver el plan de fases;
// nada aquí depende de eso ni lo anticipa con columnas muertas.
// ============================================================================

enum PayrollPeriodicity {
  monthly
  biweekly
  weekly
}

// Colombian labor-code contract shapes that actually go through payroll
// (nómina) - "prestación de servicios" (independent contractors) is
// deliberately excluded: they're not employees, don't appear here, and are
// invoiced/paid through a completely different DIAN mechanism.
enum EmployeeContractType {
  indefinido
  fijo
  obra_labor
  aprendizaje
}

// DIAN's own "SubtipoTrabajador" is a much longer catalog (judicial,
// personal_dian, madre_gestante, etc.) - this is the practical subset most
// SMB payrolls actually need. `aprendiz` and `pensionado` change which
// contributions apply (see payroll.service.js); `alto_riesgo` is informational
// today (feeds the DIAN XML in the later phase) and doesn't change the
// calculation - a high-risk worker's real difference is their ARL riskLevel,
// tracked separately below, not this field.
enum EmployeeWorkerType {
  normal
  pensionado
  aprendiz
  alto_riesgo
}

enum EmployeeStatus {
  active
  inactive
  terminated
}

// Drives whether payrollTermination.service.js computes an indemnización
// (CST art. 64, modificado por Ley 789/2002 art. 28) at all - only
// `without_just_cause` does. A real rehire is modeled as a brand-new
// Employee row (see PayrollTerminationSettlement's own comment), not by
// reusing this field, so there's no "re-activated" value here.
enum EmployeeTerminationReason {
  resignation
  just_cause
  without_just_cause
  contract_expiration
  mutual_agreement
}

// Decreto 1607 de 2002's five ARL risk classes - the rate each maps to is a
// fixed national table (payroll.service.js's ARL_RATES_BY_RISK_LEVEL), not a
// per-year legal parameter like SMLMV, so it isn't in PayrollLegalParameter.
enum ArlRiskLevel {
  I
  II
  III
  IV
  V
}

// A person paid through payroll - deliberately its own model, NOT the same
// thing as User/TeamMember (an Ohnix login/access-control concept). An
// employee usually has no Ohnix account at all, and a User is never
// implicitly an Employee just because they work at the company.
model Employee {
  id                String                     @id @default(cuid())
  documentType      String                     @default("CC") @map("document_type")
  documentNumber    String                     @map("document_number")
  firstName         String                     @map("first_name")
  secondName        String?                    @map("second_name")
  lastName          String                     @map("last_name")
  secondLastName    String?                    @map("second_last_name")
  email             String?
  phone             String?
  address           String?
  hireDate          DateTime                   @map("hire_date")
  terminationDate   DateTime?                  @map("termination_date")
  terminationReason EmployeeTerminationReason? @map("termination_reason")
  // Only meaningful for contractType = fijo - the originally pactado end
  // date, needed by payrollTermination.service.js to compute how many days
  // remained when terminated early (CST art. 64 num. 4 lit. b). Null for
  // indefinido/obra_labor/aprendizaje.
  contractEndDate   DateTime?                  @map("contract_end_date")
  contractType      EmployeeContractType       @default(indefinido) @map("contract_type")
  workerType        EmployeeWorkerType         @default(normal) @map("worker_type")
  payFrequency      PayrollPeriodicity         @default(monthly) @map("pay_frequency")
  baseSalary        Decimal                    @map("base_salary") @db.Decimal(14, 2)
  // Salario integral (CST art. 132, >= 13 SMLMV): already bundles prestaciones
  // sociales into the agreed pay, so payroll.service.js skips computing
  // separate cesantías/intereses/prima/vacaciones provisions for this
  // employee entirely rather than double-paying them.
  isIntegralSalary  Boolean                    @default(false) @map("is_integral_salary")
  riskLevel         ArlRiskLevel               @default(I) @map("risk_level")
  position          String?
  eps               String?
  pensionFund       String?                    @map("pension_fund")
  severanceFund     String?                    @map("severance_fund")
  compensationFund  String?                    @map("compensation_fund")
  bankName          String?                    @map("bank_name")
  bankAccountType   String?                    @map("bank_account_type")
  bankAccountNumber String?                    @map("bank_account_number")
  workCity          String?                    @map("work_city")
  // Optional cost-center attribution for payroll's accounting posting - same
  // resolveLocationCostCenter mechanism orders/purchases already use, keyed
  // off where this employee actually works rather than off the period/order.
  pointOfSaleId     String?                    @map("point_of_sale_id")
  status            EmployeeStatus             @default(active)
  createdById       String                     @map("created_by")
  updatedById       String?                    @map("updated_by")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  createdBy             User                          @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?                         @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id])
  pointOfSale           PointOfSale?                  @relation(fields: [pointOfSaleId], references: [id])
  payrollDocuments      PayrollDocument[]
  benefitAccruals       EmployeeBenefitAccrual[]
  benefitSettlements    PayrollBenefitSettlement[]
  terminationSettlement PayrollTerminationSettlement?

  @@unique([documentNumber, createdById])
  @@index([createdById, status])
  @@index([pointOfSaleId])
  @@map("employees")
}

// Legal constants set annually by the Colombian government - global, not
// per-tenant (every account operating in Colombia uses the same SMLMV in the
// same year), platform-admin managed the same way SystemSetting is. Seeded
// once per year; payroll.service.js reads the row matching the period's
// year and throws a clear error if that year hasn't been entered yet rather
// than silently falling back to a stale one.
model PayrollLegalParameter {
  id                        String   @id @default(cuid())
  year                      Int      @unique
  smlmv                     Decimal  @db.Decimal(14, 2)
  // Auxilio de transporte - only owed when baseSalary <= 2 * smlmv (checked
  // at calculation time, not stored here).
  transportAllowance        Decimal  @map("transport_allowance") @db.Decimal(14, 2)
  // UVT (Unidad de Valor Tributario) - the retención en la fuente monthly
  // table (ET art. 383, procedimiento 1) is expressed in UVT brackets.
  uvt                       Decimal  @db.Decimal(14, 2)
  // Legal monthly work-hours divisor used for the hourly rate behind
  // overtime/surcharges (CST art. 161, salary / monthlyWorkHours). Ley
  // 2101/2023 is phasing the legal workweek down from 48h to 42h through
  // 2026 in scheduled steps, so this is a per-year configured value, not a
  // hardcoded 240 or 230 - whoever maintains PayrollLegalParameter each year
  // sets it to whatever the CST's schedule actually requires that year.
  monthlyWorkHours          Decimal  @default(240) @map("monthly_work_hours") @db.Decimal(6, 2)
  // Fondo de solidaridad pensional brackets (Ley 100/1993 art. 27): each
  // entry is {"minSmlmv": number, "rate": number (percentage points on top
  // of the base 4% pensión employee contribution)} - e.g.
  // [{"minSmlmv":4,"rate":1},{"minSmlmv":16,"rate":1.2},...]. A salary below
  // the first bracket's minSmlmv pays no solidarity-fund surcharge at all.
  pensionSolidarityBrackets Json     @map("pension_solidarity_brackets")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("payroll_legal_parameters")
}

enum PayrollPeriodStatus {
  draft
  calculated
  approved
  paid
  cancelled
}

// One payroll run for a group of employees sharing the same periodicity -
// e.g. "nómina mensual de marzo 2027". Mirrors the draft -> calculated ->
// approved -> paid lifecycle purchases/orders/production orders already use
// in this codebase: nothing touches accounting until `approved`, and `paid`
// is the only transition that records the actual cash outflow.
model PayrollPeriod {
  id           String              @id @default(cuid())
  periodicity  PayrollPeriodicity
  startDate    DateTime            @map("start_date")
  endDate      DateTime            @map("end_date")
  paymentDate  DateTime?           @map("payment_date")
  status       PayrollPeriodStatus @default(draft)
  createdById  String              @map("created_by")
  updatedById  String?             @map("updated_by")
  calculatedAt DateTime?           @map("calculated_at")
  approvedAt   DateTime?           @map("approved_at")
  paidAt       DateTime?           @map("paid_at")
  cancelledAt  DateTime?           @map("cancelled_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  createdBy User              @relation("PayrollPeriodCreatedBy", fields: [createdById], references: [id])
  updatedBy User?             @relation("PayrollPeriodUpdatedBy", fields: [updatedById], references: [id])
  documents PayrollDocument[]

  @@index([createdById, status])
  @@map("payroll_periods")
}

enum PayrollDocumentStatus {
  draft
  calculated
  approved
  paid
  cancelled
}

// One employee's payslip within a PayrollPeriod - the eventual 1:1
// counterpart to a DIAN "NominaIndividual" document once the submission
// phase exists, but nothing here assumes that yet (no cune/xml columns -
// those get added when that phase actually starts). Status mirrors the
// parent period's own transitions (kept on both, not derived, since a
// period could in principle need per-employee exceptions later - e.g.
// someone excluded from a batch approval - even though today the service
// layer always moves every document in a period together).
model PayrollDocument {
  id                         String                @id @default(cuid())
  payrollPeriodId            String                @map("payroll_period_id")
  employeeId                 String                @map("employee_id")
  workedDays                 Decimal               @default(30) @map("worked_days") @db.Decimal(5, 2)
  // Snapshot of Employee.baseSalary at calculation time - an employee's
  // salary can change between periods; this is what THIS payslip was
  // actually computed against, same "freeze what was actually used"
  // convention as OrderDetail.costBasisApplied.
  baseSalarySnapshot         Decimal               @map("base_salary_snapshot") @db.Decimal(14, 2)
  status                     PayrollDocumentStatus @default(draft)
  totalEarnings              Decimal               @default(0) @map("total_earnings") @db.Decimal(14, 2)
  totalDeductions            Decimal               @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalEmployerContributions Decimal               @default(0) @map("total_employer_contributions") @db.Decimal(14, 2)
  netPay                     Decimal               @default(0) @map("net_pay") @db.Decimal(14, 2)
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")

  payrollPeriod     PayrollPeriod              @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee          Employee                   @relation(fields: [employeeId], references: [id])
  lines             PayrollDocumentLine[]
  electronicPayroll ElectronicPayrollDocument?

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
  @@map("payroll_documents")
}

// Nómina Electrónica (DIAN Resolución 000013 de 2021) submission for one
// PayrollDocument (one employee's payslip within a period) - the payroll
// counterpart to ElectronicInvoice, same 1:1-with-its-source-record shape
// and same itcycle-api-dian-only provider (no Factus/Alanube equivalent for
// nómina). Kept as its own model rather than columns on PayrollDocument
// itself since PayrollDocumentStatus already means something else entirely
// (the accounting draft/calculated/approved/paid/cancelled lifecycle) -
// conflating that with DIAN transmission status (issuing/submitted/
// accepted/rejected/contingency/error) would make both mean two different
// things depending on context. See electronicPayroll.service.js.
//
// ⚠️ Built against itcycle-api-dian's best-effort reconstruction of the
// Anexo Técnico de Nómina Electrónica (not yet validated against the
// official XSD or a real habilitación run) - see that repo's
// dian-engine/packages/core/src/types/payroll.ts for the same caveat.
model ElectronicPayrollDocument {
  id                    String                  @id @default(cuid())
  payrollDocumentId     String                  @unique @map("payroll_document_id")
  companyId             String                  @map("company_id")
  countryCode           String                  @map("country_code")
  provider              String                  @default("itcycle")
  status                ElectronicInvoiceStatus @default(draft)
  externalId            String?                 @unique @map("external_id")
  referenceCode         String                  @unique @map("reference_code")
  documentNumber        String?                 @map("document_number")
  cune                  String?
  rawRequest            Json?                   @map("raw_request")
  rawResponse           Json?                   @map("raw_response")
  errorMessage          String?                 @map("error_message") @db.Text
  // Same reasoning as ElectronicInvoice.certificateId/certificateProvider/certificateIdentifier.
  certificateId         String?                 @map("certificate_id")
  certificateProvider   String?                 @map("certificate_provider")
  certificateIdentifier String?                 @map("certificate_identifier")
  issuedAt              DateTime?               @map("issued_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  payrollDocument PayrollDocument                  @relation(fields: [payrollDocumentId], references: [id])
  company         Company                          @relation(fields: [companyId], references: [id])
  events          ElectronicPayrollDocumentEvent[]
  adjustments     ElectronicPayrollAdjustment[]

  @@index([companyId, createdAt])
  @@map("electronic_payroll_documents")
}

model ElectronicPayrollDocumentEvent {
  id                          String                   @id @default(cuid())
  electronicPayrollDocumentId String                   @map("electronic_payroll_document_id")
  eventType                   String                   @map("event_type")
  status                      ElectronicInvoiceStatus?
  payload                     Json?
  createdAt                   DateTime                 @default(now()) @map("created_at")

  electronicPayrollDocument ElectronicPayrollDocument @relation(fields: [electronicPayrollDocumentId], references: [id], onDelete: Cascade)

  @@index([electronicPayrollDocumentId, createdAt])
  @@map("electronic_payroll_document_events")
}

/// Nómina Individual de Ajuste (DIAN "1" Reemplazar / "2" Eliminar) - a
/// correction against an already-ACCEPTED ElectronicPayrollDocument. Mirrors
/// ElectronicCreditNote's relationship to ElectronicInvoice (a correction
/// document referencing its already-accepted original), not a 1:1 like
/// ElectronicPayrollDocument itself - a payslip can in principle be corrected
/// more than once over its lifetime.
model ElectronicPayrollAdjustment {
  id                          String                  @id @default(cuid())
  electronicPayrollDocumentId String                  @map("electronic_payroll_document_id")
  companyId                   String                  @map("company_id")
  countryCode                 String                  @map("country_code")
  provider                    String                  @default("itcycle")
  // "1" Reemplazar / "2" Eliminar - matches DIAN's PayrollAdjustmentType
  // catalog verbatim rather than an Ohnix-specific enum, same reasoning as
  // ElectronicCreditNote.correctionConceptCode.
  adjustmentType              String                  @map("adjustment_type")
  status                      ElectronicInvoiceStatus @default(draft)
  externalId                  String?                 @unique @map("external_id")
  referenceCode               String                  @unique @map("reference_code")
  documentNumber              String?                 @map("document_number")
  cune                        String?
  rawRequest                  Json?                   @map("raw_request")
  rawResponse                 Json?                   @map("raw_response")
  errorMessage                String?                 @map("error_message") @db.Text
  certificateId               String?                 @map("certificate_id")
  certificateProvider         String?                 @map("certificate_provider")
  certificateIdentifier       String?                 @map("certificate_identifier")
  issuedAt                    DateTime?               @map("issued_at")
  createdAt                   DateTime                @default(now()) @map("created_at")
  updatedAt                   DateTime                @updatedAt @map("updated_at")

  electronicPayrollDocument ElectronicPayrollDocument @relation(fields: [electronicPayrollDocumentId], references: [id])
  company                   Company                   @relation(fields: [companyId], references: [id])

  @@index([electronicPayrollDocumentId, createdAt])
  @@index([companyId, createdAt])
  @@map("electronic_payroll_adjustments")
}

enum PayrollConceptCategory {
  earning
  deduction
  employer_contribution
}

// DIAN's own "nómina individual" concept catalog, trimmed to what
// payroll.service.js actually computes in this phase - extending this enum
// later (e.g. for the XML-submission phase's exact DIAN codes) is additive
// and never renames an existing value, so historical PayrollDocumentLine
// rows keep meaning exactly what they meant when they were written.
enum PayrollConceptCode {
  basic_salary
  transport_allowance
  overtime_day
  overtime_night
  surcharge_night
  surcharge_sunday_holiday
  overtime_sunday_holiday_day
  overtime_sunday_holiday_night
  common_vacation
  bonus
  other_earning
  health_employee
  pension_employee
  pension_solidarity_fund
  withholding_tax
  other_deduction
  health_employer
  pension_employer
  arl
  sena
  icbf
  compensation_fund
  severance_employer
  severance_interest_employer
  service_bonus_employer
  vacation_provision
}

// One line of a PayrollDocument - the same flat, tagged-line shape
// PayrollLegalParameter's siblings (JournalEntryLine, OrderDetail) already
// use instead of a wide table with one column per possible concept.
// quantity/rate are only meaningful for hour-based concepts (overtime,
// surcharges); amount is always the final line value regardless.
model PayrollDocumentLine {
  id                String                 @id @default(cuid())
  payrollDocumentId String                 @map("payroll_document_id")
  category          PayrollConceptCategory
  conceptCode       PayrollConceptCode     @map("concept_code")
  description       String?
  quantity          Decimal?               @db.Decimal(10, 2)
  rate              Decimal?               @db.Decimal(14, 4)
  amount            Decimal                @db.Decimal(14, 2)
  createdAt         DateTime               @default(now()) @map("created_at")

  payrollDocument PayrollDocument @relation(fields: [payrollDocumentId], references: [id], onDelete: Cascade)

  @@index([payrollDocumentId])
  @@map("payroll_document_lines")
}

// Which recurring social-benefit provision this accrual row tracks -
// severance/severance_interest/vacation run per calendar year, service_bonus
// runs per semester within a year (see `semester` below).
enum BenefitAccrualType {
  severance
  severance_interest
  service_bonus
  vacation
}

// Running provision balance per employee/year(/semester) - accrued a little
// more each time a PayrollPeriod for that employee is approved (see
// payroll.service.js#accrueBenefits), settled (paid out) via
// PayrollBenefitSettlement below. `vacation` is the one type tracked in DAYS
// (accruedDays/usedDays) instead of money - CST art. 186 grants 15 WORKING
// days per year worked (1.25 days/month), and "how many days are owed" is
// the number that actually matters operationally, not a currency value that
// would just be days * daily-rate anyway and go stale the moment the
// employee's salary changes.
model EmployeeBenefitAccrual {
  id            String             @id @default(cuid())
  employeeId    String             @map("employee_id")
  year          Int
  semester      Int?
  type          BenefitAccrualType
  accruedAmount Decimal            @default(0) @map("accrued_amount") @db.Decimal(14, 2)
  settledAmount Decimal            @default(0) @map("settled_amount") @db.Decimal(14, 2)
  accruedDays   Decimal            @default(0) @map("accrued_days") @db.Decimal(7, 3)
  usedDays      Decimal            @default(0) @map("used_days") @db.Decimal(7, 3)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year, semester, type])
  @@index([employeeId, type])
  @@map("employee_benefit_accruals")
}

// Audit trail of an actual payout against an EmployeeBenefitAccrual balance
// (prima de junio/diciembre, cesantías consignadas al fondo antes del 14 de
// febrero) - see payroll.service.js#settleBenefit. Never mutates the
// accrual's history away; `settledAmount` on the accrual row is the running
// total these settlements sum to.
model PayrollBenefitSettlement {
  id          String             @id @default(cuid())
  employeeId  String             @map("employee_id")
  type        BenefitAccrualType
  year        Int
  semester    Int?
  amount      Decimal            @db.Decimal(14, 2)
  paymentDate DateTime           @default(now()) @map("payment_date")
  createdById String             @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([employeeId, type])
  @@map("payroll_benefit_settlements")
}

// The consolidated "acta de liquidación" for one employee's final
// settlement - see payrollTermination.service.js. One per employee
// (@unique employeeId): a real rehire is modeled as a brand-new Employee
// row rather than un-terminating this one, same convention most payroll
// systems use, so there's never a second settlement to record here.
// Every *Amount field is what THIS settlement actually drained/paid,
// snapshotted independently of EmployeeBenefitAccrual's running balances
// (which move on afterward) - same "freeze what was used" convention as
// PayrollDocument.baseSalarySnapshot. indemnityAmount/indemnityDays are 0/
// null when terminationReason isn't without_just_cause, or when
// manualIndemnityOverride was used instead of the CST art. 64 formula.
model PayrollTerminationSettlement {
  id                      String                    @id @default(cuid())
  employeeId              String                    @unique @map("employee_id")
  terminationDate         DateTime                  @map("termination_date")
  terminationReason       EmployeeTerminationReason @map("termination_reason")
  baseSalarySnapshot      Decimal                   @map("base_salary_snapshot") @db.Decimal(14, 2)
  severanceAmount         Decimal                   @default(0) @map("severance_amount") @db.Decimal(14, 2)
  severanceInterestAmount Decimal                   @default(0) @map("severance_interest_amount") @db.Decimal(14, 2)
  serviceBonusAmount      Decimal                   @default(0) @map("service_bonus_amount") @db.Decimal(14, 2)
  vacationAmount          Decimal                   @default(0) @map("vacation_amount") @db.Decimal(14, 2)
  indemnityAmount         Decimal                   @default(0) @map("indemnity_amount") @db.Decimal(14, 2)
  indemnityDays           Decimal?                  @map("indemnity_days") @db.Decimal(6, 2)
  totalAmount             Decimal                   @map("total_amount") @db.Decimal(14, 2)
  cashAccountId           String                    @map("cash_account_id")
  createdById             String                    @map("created_by")
  createdAt               DateTime                  @default(now()) @map("created_at")

  employee    Employee    @relation(fields: [employeeId], references: [id])
  createdBy   User        @relation(fields: [createdById], references: [id])
  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id])

  @@map("payroll_termination_settlements")
}
