NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017
DB_PROVIDER=mongo
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ohnix?schema=public

# JWT
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_another_long_random_secret
REFRESH_TOKEN_EXPIRY=7d

# App URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://ohnix.vercel.app,https://*.vercel.app

# Scheduler and timezone
START_SCHEDULER=false
TIMEZONE=America/Mexico_City

# Email (optional, required for OTP and alerts)
SENDER_EMAIL=
SENDER_PASSWORD=
EMAIL_USER=

# Cloudinary (optional, required if uploading images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=