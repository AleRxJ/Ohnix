NODE_ENV=development
PORT=3000

# Database (use postgres/prisma to avoid Mongo dependency)
DB_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ohnix?schema=public
MONGODB_URI=
DB_CONNECT_MAX_RETRIES=5
DB_CONNECT_RETRY_MS=2000

# JWT
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_another_long_random_secret
REFRESH_TOKEN_EXPIRY=7d

# App URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://ohnix.vercel.app,https://*.vercel.app

# Scheduler and timezone
START_SCHEDULER=false
TIMEZONE=America/Mexico_City
AUTH_DEBUG=false

# Redis (single active session enforcement + team live presence in phase 2).
# Without this set, single-session and presence features are silently
# disabled (fail-open) rather than blocking auth - see utils/redisClient.js.
REDIS_URL=

# Email (required for OTP and low-stock alert emails)
# IMPORTANT: keep EMAIL_USER equal to SENDER_EMAIL for current controllers.
SENDER_EMAIL=
SENDER_PASSWORD=
EMAIL_USER=

# Cloudflare R2 (optional in dev - falls back to local disk storage under
# Backend/public/temp when unset; required in production for image uploads
# to persist). Create a bucket in the Cloudflare dashboard (R2 > Create
# bucket), then R2 > Manage API tokens > Create API token for
# R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY. R2_ACCOUNT_ID is in the URL of your
# Cloudflare dashboard. R2_PUBLIC_URL is either the bucket's public r2.dev
# URL (enable under bucket Settings > Public access) or a custom domain
# connected to the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Stripe autonomous checkout (CO/ES)
# Use test keys in development.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# One-time upgrade amounts in the smallest currency unit
# COP: no decimals (99000 = COP 99,000)
STRIPE_AMOUNT_GROWTH_COP=99000
STRIPE_AMOUNT_SCALE_COP=200000
STRIPE_AMOUNT_ENTERPRISE_COP=299000

# EUR: cents (2900 = EUR 29.00)
STRIPE_AMOUNT_GROWTH_EUR=2900
STRIPE_AMOUNT_SCALE_EUR=5900
STRIPE_AMOUNT_ENTERPRISE_EUR=9900

# USD: cents. NOT YET SET - "rest of world" (non-Colombia, non-Eurozone)
# Stripe checkout will fail with a clear "amount not configured" error until
# these are filled in with the approved USD price. Until then, the public
# pricing endpoint (GET /api/v1/pricing/public) falls back to displaying the
# reference price from PLAN_PRICES_USD (pricing.middleware.js) - a
# display-only fallback, NOT a substitute for actually configuring these.
STRIPE_AMOUNT_STARTER_USD=
STRIPE_AMOUNT_GROWTH_USD=
STRIPE_AMOUNT_SCALE_USD=
STRIPE_AMOUNT_ENTERPRISE_USD=

# ePayco autonomous checkout (Colombia). Sandbox/test keys come from your
# ePayco dashboard (Configuración > Mi cuenta / Api Keys). EPAYCO_TEST=TRUE
# routes to their sandbox; set FALSE only when going live with real keys.
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_CUST_ID=
EPAYCO_TEST=TRUE

# Public URLs where ePayco calls back - must be reachable from ePayco's
# servers (no localhost outside local dev with a tunnel).
EPAYCO_RESPONSE_URL=https://api.ohnix.co/api/v1/subscriptions/payments/epayco/response
EPAYCO_CONFIRMATION_URL=https://api.ohnix.co/api/v1/subscriptions/payments/epayco/confirmation

# Amounts in COP (smallest unit, no decimals). Falls back to the matching
# STRIPE_AMOUNT_*_COP above if left unset, so these only need to be set if
# ePayco pricing should differ from Stripe's.
EPAYCO_AMOUNT_GROWTH_COP=99000
EPAYCO_AMOUNT_SCALE_COP=200000
EPAYCO_AMOUNT_ENTERPRISE_COP=299000

# Optional: tune background legacy reconciliation
SUBSCRIPTION_RECONCILE_INTERVAL_MINUTES=15

# Factus V2 / DIAN electronic invoicing (Colombia).
# Every path/field below is verified against the official Factus V2 Postman
# collection (api-factus-v2.json) - that collection is the source of truth
# for this integration, not the public docs site, which disagrees with it
# in places (e.g. it advertises /v1/credit-notes/validate; the collection
# and the actual API only expose /v2/credit-notes/validate).

# --- Sandbox vs production: switch by env var only, no code changes ----
# Everything in factus.service.js reads FACTUS_BASE_URL - swap it and the
# whole integration follows, nothing else to touch. Uncomment ONE line.
# Keep the sandbox line active until the full flow (tax calc, numbering
# ranges, credit notes) has been tested end to end - this template ships
# with PRODUCTION active by default, which is a live, billable Factus
# environment the moment real credentials are filled in below.
# FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_BASE_URL=https://api.factus.com.co

FACTUS_AUTH_PATH=/oauth/token
FACTUS_INVOICE_PATH=/v2/bills/validate
FACTUS_INVOICE_STATUS_PATH=/v2/bills/{number}
FACTUS_CREDIT_NOTE_PATH=/v2/credit-notes/validate

# grant_type used against /oauth/token. The collection only ever demonstrates
# "password" (+ "refresh_token" to renew) - it does NOT include a
# client_credentials example anywhere. Keep this as "password" unless Factus
# support explicitly confirms client_credentials is supported for your
# account; the auth body building code will silently send the wrong grant
# otherwise and every request will fail authentication.
FACTUS_AUTH_MODE=password

# Real credentials - obtained from your Factus account (portal/dashboard at
# factus.com.co, or from Factus support if you can't find them there). These
# are the same values used to populate the client_id/client_secret/email/
# password variables in Factus's own Postman environment file.
# Treat as secrets: never commit real values, rotate via the Factus portal
# if leaked.
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=

# Optional dev/testing shortcut ONLY: a pre-obtained access token, used
# as-is instead of running the OAuth flow. Factus access tokens expire
# hourly (confirmed on developers.factus.com.co), so this is not viable for
# production - leave empty there and let the app authenticate with
# CLIENT_ID/CLIENT_SECRET/USERNAME/PASSWORD on every token request.
FACTUS_ACCESS_TOKEN=

FACTUS_TIMEOUT_MS=20000

# No FACTUS_WEBHOOK_SECRET here on purpose: the official Postman collection
# has no webhook/event-push endpoint anywhere, and every "crear y validar"
# call (bills, credit notes, debit notes, support documents) responds
# synchronously with the final validation result in the same HTTP response.
# The webhook route/handler this app used to have was removed on 2026-08-04
# for that reason - see the comment in services/electronicInvoicing.service.js.
# If Factus support ever confirms a real async event-push feature, add this
# variable back along with the route.
