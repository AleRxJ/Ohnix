NODE_ENV=development
PORT=3000

# Database (use postgres/prisma to avoid Mongo dependency)
DB_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ohnix?schema=public
MONGODB_URI=
DB_CONNECT_MAX_RETRIES=5
DB_CONNECT_RETRY_MS=2000

# JWT
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_another_long_random_secret
REFRESH_TOKEN_EXPIRY=7d

# App URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://ohnix.vercel.app,https://*.vercel.app

# Scheduler and timezone
START_SCHEDULER=false
TIMEZONE=America/Mexico_City
AUTH_DEBUG=false

# Email (required for OTP and low-stock alert emails)
# IMPORTANT: keep EMAIL_USER equal to SENDER_EMAIL for current controllers.
SENDER_EMAIL=
SENDER_PASSWORD=
EMAIL_USER=

# Cloudinary (optional, required if uploading images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe autonomous checkout (CO/ES)
# Use test keys in development.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# One-time upgrade amounts in the smallest currency unit
# COP: no decimals (99000 = COP 99,000)
STRIPE_AMOUNT_GROWTH_COP=99000
STRIPE_AMOUNT_ENTERPRISE_COP=299000

# EUR: cents (2900 = EUR 29.00)
STRIPE_AMOUNT_GROWTH_EUR=2900
STRIPE_AMOUNT_ENTERPRISE_EUR=9900

# Optional: tune background legacy reconciliation
SUBSCRIPTION_RECONCILE_INTERVAL_MINUTES=15